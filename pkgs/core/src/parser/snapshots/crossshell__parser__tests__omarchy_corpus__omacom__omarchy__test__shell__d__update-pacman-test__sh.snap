---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/update-pacman-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(dirname \"$0\")/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "test_tmp",
                        value: "$(mktemp -d)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "trap",
                args: [
                    "rm -rf \"$test_tmp\"",
                    "EXIT",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "stub_bin",
                        value: "$test_tmp/bin",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "$stub_bin",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$stub_bin/sudo",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "STUB",
                    here_document: 0,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "chmod",
                args: [
                    "+x",
                    "$stub_bin/sudo",
                ],
            },
        ),
        Function {
            name: "run_helper",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [
                                    CshAstAssignment {
                                        name: "PATH",
                                        value: "$stub_bin:$PATH",
                                    },
                                    CshAstAssignment {
                                        name: "SUDO_CALL_LOG",
                                        value: "$test_tmp/call",
                                    },
                                ],
                                name: "$ROOT/bin/omarchy-update-pacman",
                                args: [
                                    "$@",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -d /run/systemd/system && ! -L /run/systemd/system ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "expected_scope",
                                            value: "systemd-run --scope --quiet --collect ",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: Some(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [
                                    CshAstAssignment {
                                        name: "expected_scope",
                                        value: "",
                                    },
                                ],
                                name: "",
                                args: [],
                            },
                        ),
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_helper",
                args: [
                    "-Syu",
                    "--noconfirm",
                ],
            },
        ),
        Binary {
            left: Test(
                " $(cat \"$test_tmp/call\") == \"env OMARCHY_UPDATE_PACMAN=1 ${expected_scope}pacman -Syu --noconfirm\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "helper composes the guarded pacman invocation",
                        "$(cat \"$test_tmp/call\")",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "helper composes the guarded pacman invocation",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "LC_ALL",
                        value: "C",
                    },
                ],
                name: "run_helper",
                args: [
                    "-Syu",
                ],
            },
        ),
        Binary {
            left: Test(
                " $(cat \"$test_tmp/call\") == \"env OMARCHY_UPDATE_PACMAN=1 LC_ALL=C ${expected_scope}pacman -Syu\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "helper forwards LC_ALL to the transaction",
                        "$(cat \"$test_tmp/call\")",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "helper forwards LC_ALL to the transaction",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "STUB",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nprintf '%s\\n' \"$*\" >\"$SUDO_CALL_LOG\"\n",
        },
    ],
}
