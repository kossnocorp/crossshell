                                            },
                                        ),
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Binary {
                                            left: Test(
                                                " -z $package || $package == \\#* ",
                                            ),
                                            operator: And,
                                            right: Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "continue",
                                                    args: [],
                                                },
                                            ),
                                        },
                                        Binary {
                                            left: Redirected {
                                                expression: Command(
