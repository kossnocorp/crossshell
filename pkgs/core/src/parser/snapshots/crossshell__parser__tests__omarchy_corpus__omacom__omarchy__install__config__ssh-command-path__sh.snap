---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/config/ssh-command-path.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Negated(
                                Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: Some(
                                            Literal(
                                                "grep",
                                            ),
                                        ),
                                        args: [
                                            Literal(
                                                "-qE",
                                            ),
                                            SingleQuoted(
                                                "^PATH[[:space:]]",
                                            ),
                                            Literal(
                                                "/etc/security/pam_env.conf",
                                            ),
                                        ],
                                    },
                                ),
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: Some(
                                            Literal(
                                                "cat",
                                            ),
                                        ),
                                        args: [],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: Default,
                                        operator: Append,
                                        target: Literal(
                                            "/etc/security/pam_env.conf",
                                        ),
                                    },
                                    CshAstRedirect {
                                        descriptor: Default,
                                        operator: HereDocument,
                                        target: Literal(
                                            "EOF",
                                        ),
                                        here_document: 0,
                                    },
                                ],
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            content: Literal(
                "\n# Omarchy: give SSH commands and other non-shell logins the user-level tool paths\nPATH DEFAULT=/usr/local/sbin:/usr/local/bin:/usr/bin:@{HOME}/.local/share/mise/shims:@{HOME}/.local/bin\n",
            ),
        },
    ],
}
