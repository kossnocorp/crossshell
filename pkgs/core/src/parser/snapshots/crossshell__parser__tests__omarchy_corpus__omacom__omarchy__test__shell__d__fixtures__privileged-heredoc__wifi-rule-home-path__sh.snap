            strip_tabs: false,
            body: "SUBSYSTEM==\"power_supply\", ATTR{type}==\"Mains\", ATTR{online}==\"0\", RUN+=\"$HOME/.local/share/omarchy/bin/omarchy-wifi-powersave on\"\nSUBSYSTEM==\"power_supply\", ATTR{type}==\"Mains\", ATTR{online}==\"1\", RUN+=\"$HOME/.local/share/omarchy/bin/omarchy-wifi-powersave off\"\n",
