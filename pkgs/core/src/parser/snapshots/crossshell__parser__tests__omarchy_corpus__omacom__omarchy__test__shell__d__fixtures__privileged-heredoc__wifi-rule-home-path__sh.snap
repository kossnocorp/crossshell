                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Binary {
                                left: Redirected {
                                    expression: Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "cat",
                                            args: [],
                                        },
                                    ),
                                    redirects: [
                                        CshAstRedirect {
                                            descriptor: None,
                                            operator: "<<",
                                            target: "EOF",
                                            here_document: 0,
                                        },
                                    ],
                                },
                                operator: Pipe,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "sudo",
                                        args: [
                                            "tee",
                                            "/etc/udev/rules.d/99-wifi-powersave.rules",
                                        ],
                                    },
                                ),
                            },
                            Command(
