            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\n:\n",
        },
        CshAstHereDocument {
            delimiter: "LUA",
            quoted: true,
            strip_tabs: false,
            body: "local disabled = {}\nhl = { device = function(opts) table.insert(disabled, opts) end }\ndofile(os.getenv(\"OMARCHY_PATH\") .. \"/default/hypr/bootstrap.lua\")\nrequire(\"default.hypr.toggles\")\nassert(#disabled == 1, \"only the current name-file disable is applied\")\nassert(disabled[1].name == \"elan-touchpad\", \"disable uses the stored device name\")\nassert(disabled[1].enabled == false)\n",
        },
