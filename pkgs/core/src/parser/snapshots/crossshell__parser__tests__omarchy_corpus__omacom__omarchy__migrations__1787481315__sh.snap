CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Re-stage the current theme so an installed theme's code is dropped",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "theme_name_path",
                        value: "$HOME/.local/state/omarchy/current/theme.name",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " -s $theme_name_path ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "theme_name",
                        value: "$(<\"$theme_name_path\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " ! -d $OMARCHY_PATH/themes/$theme_name && ! -d $HOME/.config/omarchy/themes/$theme_name ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "echo",
                                    args: [
                                        "Theme '$theme_name' no longer exists; applying the default instead",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-theme-set",
                                    args: [
                                        "Tokyo Night",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "exit",
                                    args: [
                                        "0",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "omarchy-theme-refresh",
                args: [],
            },
