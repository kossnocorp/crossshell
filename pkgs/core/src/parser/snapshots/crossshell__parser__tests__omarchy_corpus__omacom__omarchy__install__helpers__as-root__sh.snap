---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/helpers/as-root.sh"
expression: ast
---
CshAst {
    commands: [
        Function {
            name: "as_root",
            body: Group(
                CshAst {
                    commands: [
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Arithmetic(
                                                " EUID == 0 ",
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "$@",
                                                    args: [],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: Some(
                                CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "sudo",
                                                args: [
                                                    "$@",
                                                ],
                                            },
                                        ),
                                    ],
                                },
                            ),
                        },
                    ],
                },
            ),
        },
    ],
}
