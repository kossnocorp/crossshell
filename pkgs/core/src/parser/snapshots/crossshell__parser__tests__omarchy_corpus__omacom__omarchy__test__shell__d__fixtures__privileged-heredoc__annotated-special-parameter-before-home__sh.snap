---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/fixtures/privileged-heredoc/annotated-special-parameter-before-home.sh"
expression: ast
---
CshAst {
    commands: [
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "sudo",
                    args: [
                        "tee",
                        "/etc/omarchy/example.conf",
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
                    here_document: 0,
                },
            ],
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            body: "argument=$1\ncommand=$HOME/.local/share/omarchy/bin/example\n",
        },
    ],
}
