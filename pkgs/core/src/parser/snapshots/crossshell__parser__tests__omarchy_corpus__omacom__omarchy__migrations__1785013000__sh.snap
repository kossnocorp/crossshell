---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/migrations/1785013000.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Move zram tuning to a vendor drop-in",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "zram_conf",
                        value: "${OMARCHY_ZRAM_CONF:-/etc/systemd/zram-generator.conf}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "zram_dropin",
                        value: "${OMARCHY_ZRAM_DROPIN:-/usr/lib/systemd/zram-generator.conf.d/90-omarchy.conf}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " -f $zram_conf ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " -f $zram_dropin ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Redirected {
                expression: Command(
                    CshAstCommand {
                        assignments: [],
                        name: "pacman",
                        args: [
                            "-Qo",
                            "$zram_conf",
                        ],
                    },
                ),
                redirects: [
                    CshAstRedirect {
                        descriptor: None,
                        operator: "&>",
                        target: "/dev/null",
                    },
                ],
            },
            operator: And,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [
                        CshAstAssignment {
                            name: "settings",
                            value: "$(grep -vE '^[[:space:]]*([#;]|$)' \"$zram_conf\" | tr -d '[:space:]')",
                        },
                    ],
                    name: "",
                    args: [],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "true",
                    args: [],
                },
            ),
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -z $settings || $settings =~ ^\\[zram0\\]compression-algorithm=[[:alnum:]-]+$ ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Binary {
                                left: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "sudo",
                                        args: [
                                            "rm",
                                            "-f",
                                            "$zram_conf",
                                        ],
                                    },
                                ),
                                operator: Or,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "true",
                                        args: [],
                                    },
                                ),
                            },
                        ],
                    },
                },
            ],
            otherwise: Some(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "Keeping $zram_conf; it has local edits.",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "Omarchy's drop-in overrides it. Move your changes to",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "/etc/systemd/zram-generator.conf.d/99-local.conf to keep them in effect.",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
    ],
}
