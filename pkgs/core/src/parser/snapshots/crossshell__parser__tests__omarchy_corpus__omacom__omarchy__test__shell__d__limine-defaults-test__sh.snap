        ),
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [],
                    name: "grep",
                    args: [
                        "-Fq",
                        "KERNEL_CMDLINE[default]+=\" initramfs_async=0\"",
                        "$packaged_defaults",
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "the packaged Limine defaults still unpack the initramfs synchronously",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "packaged Limine defaults keep Plymouth alive at the LUKS prompt",
                ],
            },
        ),
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [],
                    name: "grep",
                    args: [
                        "-Fxq",
                        "BOOT_ORDER=\"linux-t2, linux-omarchy, linux-omarchy-*, *, *fallback, Snapshots\"",
                        "$packaged_defaults",
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "packaged Limine defaults protect T2 Macs and prefer the exact Omarchy kernel elsewhere",
