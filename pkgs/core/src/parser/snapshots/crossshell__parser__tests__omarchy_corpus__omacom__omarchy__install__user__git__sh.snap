---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/user/git.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -n ${OMARCHY_USER_NAME//[[:space:]]/} ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "git",
                                    args: [
                                        "config",
                                        "--global",
                                        "user.name",
                                        "$OMARCHY_USER_NAME",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -n ${OMARCHY_USER_EMAIL//[[:space:]]/} ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "git",
                                    args: [
                                        "config",
                                        "--global",
                                        "user.email",
                                        "$OMARCHY_USER_EMAIL",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
