---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/power-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "run_node_test",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "JS",
                    here_document: 0,
                },
            ],
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "JS",
            quoted: true,
            strip_tabs: false,
            body: "const fs = require('fs')\nconst power = requireFromRoot('shell/plugins/panels/power/Model.js')\nconst panelSource = fs.readFileSync(root + '/shell/plugins/panels/power/Panel.qml', 'utf8')\nconst states = { Charging: 1, Discharging: 2, FullyCharged: 3, PendingCharge: 4 }\n\nassertEqual(power.selectProfileIndex(0, 1, ['balanced', 'performance']), 1, 'power advances profile selection')\nassertEqual(power.selectProfileIndex(1, 1, ['balanced', 'performance']), 1, 'power clamps profile selection')\n\nassertDeepEqual(power.parseKeyValue('time\\t2:00\\nenergy\\t42\\n'), { time: '2:00', energy: '42' }, 'power parses key-value output')\nassertDeepEqual(\n  power.parseProfiles('power-saver\\t0\\nbalanced\\t1\\nperformance\\t0\\n', 5),\n  { profiles: ['power-saver', 'balanced', 'performance'], activeProfile: 'balanced', profileIndex: 2 },\n  'power parses profile output and clamps selection'\n)\n\nassert(power.profileIcon('performance').length > 0, 'power maps profile icons')\nassertEqual(power.batteryFraction({ isPresent: true, percentage: 1.5 }), 1, 'power clamps battery fraction')\n\nassert(power.chargeThresholdActive({ isPresent: true, percentage: 0.8, state: states.PendingCharge }, false, states), 'power detects threshold by pending charge state')\nassert(power.chargeThresholdActive({ isPresent: true, percentage: 0.8, state: states.Charging, changeRate: 0.1, timeToFull: 120 }, false, states), 'power detects threshold by stalled charging')\nassert(!power.chargeThresholdActive({ isPresent: true, percentage: 0.8, state: states.Charging, changeRate: 1.0, timeToFull: 120 }, false, states), 'power does not flag active charging as threshold')\nassert(!power.chargeThresholdActive({ isPresent: true, percentage: 0.5, state: states.Discharging }, false, states), 'power does not flag discharging as threshold')\nassertEqual(power.modeLabel({ isPresent: true, percentage: 1, state: states.FullyCharged }, false, states), 'Fully charged', 'power labels full battery')\nassertEqual(power.modeLabel({ isPresent: true, percentage: 0.5, state: states.Discharging }, true, states), 'On battery', 'power labels battery mode')\nassertEqual(power.modeLabel({ isPresent: true, percentage: 0.5, state: states.Discharging }, false, states), 'Charging', 'power treats external power as newer than stale discharging state')\nassert(power.batteryIcon({ isPresent: true, percentage: 0.4, state: states.Charging }, false, states).length > 0, 'power maps battery icons')\nassertEqual(\n  power.batteryIcon({ isPresent: true, percentage: 0.4, state: states.Discharging }, false, states),\n  power.batteryIcon({ isPresent: true, percentage: 0.4, state: states.Charging, changeRate: 1.0, timeToFull: 120 }, false, states),\n  'power shows charging icon when external power is present before battery state refreshes'\n)\nassertEqual(\n  power.batteryIcon({ isPresent: true, percentage: 0.4, state: states.Charging }, true, states),\n  power.batteryIcon({ isPresent: true, percentage: 0.4, state: states.Discharging }, true, states),\n  'power shows battery icon when unplugged before battery state refreshes'\n)\n\nassert(/if \\(b === Qt\\.RightButton\\) root\\.togglePercentage\\(\\)/.test(panelSource), 'power right click toggles the bar percentage')\nassert(/Object\\.assign\\([^\\n]+showPercentage: !root\\.showPercentage[^\\n]+\\)[\\s\\S]*updateEntryInline/.test(panelSource), 'power persists the bar percentage setting')\nassert(/Math\\.round\\(root\\.batteryFraction \\* 100\\) \\+ \"% \" \\+ root\\.batteryIcon\\(\\)/.test(panelSource), 'power places the percentage before the battery icon')\nassert(/openPanelIndicatorWidth:.*showPercentage.*button\\.glyphPaintedWidth : 0/.test(panelSource), 'power spans the open-panel mark across the painted percentage block')\nassert(/IpcHandler[\\s\\S]*?function togglePercentage\\(\\) \\{ root\\.togglePercentage\\(\\) \\}/.test(panelSource), 'power exposes togglePercentage over IPC')\nassert(/manageIpc: false/.test(panelSource), 'power owns its IPC handler so it can extend the target methods')\n",
        },
    ],
}
