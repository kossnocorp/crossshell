---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/sudoless-docker-posture-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "TMPDIR",
                        value: "$(mktemp -d)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "trap",
                args: [
                    "rm -rf \"$TMPDIR\"",
                    "EXIT",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "$TMPDIR/bin",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "printf",
                    args: [
                        "#!/bin/bash\\nexit 0\\n",
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$TMPDIR/bin/getent",
                },
            ],
        },
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$TMPDIR/bin/pacman",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "STUB",
                    here_document: 0,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "chmod",
                args: [
                    "+x",
                    "$TMPDIR/bin/getent",
                    "$TMPDIR/bin/pacman",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "PATH=$TMPDIR/bin:$PATH",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "PROVISIONING_DIR",
                        value: "$TMPDIR/prov",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "$PROVISIONING_DIR",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "printf",
                    args: [
                        "wheel\\ninput\\ndocker\\n",
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$PROVISIONING_DIR/groups",
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "eval",
                args: [
                    "$(sed -n '/^user_groups() {/,/^}/p' \"$ROOT/bin/omarchy-provision-owner\")",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "groups",
                        value: "$(user_groups)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " \",$groups,\" == *\",wheel,\"* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "user_groups always includes wheel",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " \",$groups,\" != *\",input,\"* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "user_groups must not replay the blanket input grant",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " \",$groups,\" == *\",docker,\"* ",
            ),
            operator: And,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "user_groups must never grant the docker group",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "first-boot user_groups replays neither privileged default",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "groups",
                        value: "$(STUB_PACKAGES=xpadneo-dkms user_groups)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " \",$groups,\" == *\",input,\"* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "user_groups keeps input for installed controller support",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "groups",
                        value: "$(STUB_PACKAGES=ydotool user_groups)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " \",$groups,\" == *\",input,\"* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "user_groups keeps input for installed ydotool support",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "first-boot user_groups keeps deliberate input-group opt-ins",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "rg",
                                    args: [
                                        "-q",
                                        "usermod -aG docker",
                                        "$ROOT/bin/omarchy-upgrade-to-quattro",
                                    ],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "omarchy-upgrade-to-quattro must not add the user to the docker group",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "the Quattro upgrade does not grant the docker group",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "STUB",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\n[[ $1 == \"-Qq\" ]] || exit 2\n[[ \" ${STUB_PACKAGES:-} \" == *\" $2 \"* ]]\n",
        },
    ],
}
