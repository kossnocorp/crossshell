            body: "#!/bin/bash\n\nprintf 'mktemp' >>\"$TEST_BARE_MKTEMP\"\nprintf '\\t%s' \"$@\" >>\"$TEST_BARE_MKTEMP\"\nprintf '\\n' >>\"$TEST_BARE_MKTEMP\"\nexit 98\n",
