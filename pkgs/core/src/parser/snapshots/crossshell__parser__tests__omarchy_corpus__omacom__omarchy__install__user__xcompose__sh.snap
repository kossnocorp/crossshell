---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/user/xcompose.sh"
expression: ast
---
CshAst {
    commands: [
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "tee",
                    args: [
                        "~/.XCompose",
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "/dev/null",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
                    here_document: 0,
                },
            ],
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            body: "# Run omarchy-restart-xcompose to apply changes\n\n# Include fast emoji access\ninclude \"/usr/share/omarchy/default/xcompose\"\n\n# Identification\n<Multi_key> <space> <n> : \"$OMARCHY_USER_NAME\"\n<Multi_key> <space> <e> : \"$OMARCHY_USER_EMAIL\"\n",
        },
    ],
}
