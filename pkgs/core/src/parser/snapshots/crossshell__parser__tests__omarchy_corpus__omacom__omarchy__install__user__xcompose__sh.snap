                    assignments: [],
                    name: Some(
                        Literal(
                            "tee",
                        ),
                    ),
                    args: [
                        Concat(
                            [
                                Tilde(
                                    Home,
                                ),
                                Literal(
                                    "/.XCompose",
                                ),
                            ],
                        ),
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: Default,
                    operator: Output,
                    target: Literal(
                        "/dev/null",
                    ),
                },
                CshAstRedirect {
                    descriptor: Default,
                    operator: HereDocument,
                    target: Literal(
                        "EOF",
                    ),
                    here_document: 0,
