            ],
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            content: Concat(
                [
                    Literal(
                        "# Run omarchy-restart-xcompose to apply changes\n\n# Include fast emoji access\ninclude \"/usr/share/omarchy/default/xcompose\"\n\n# Identification\n<Multi_key> <space> <n> : \"",
                    ),
                    Variable(
                        "OMARCHY_USER_NAME",
                    ),
                    Literal(
                        "\"\n<Multi_key> <space> <e> : \"",
                    ),
                    Variable(
                        "OMARCHY_USER_EMAIL",
                    ),
