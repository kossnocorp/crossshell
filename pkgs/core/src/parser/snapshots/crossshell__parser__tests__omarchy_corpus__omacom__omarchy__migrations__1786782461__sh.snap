---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/migrations/1786782461.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Remove the literal \\n[text-bindings] line an earlier migration wrote into foot.ini",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "foot_config",
                        value: "$HOME/.config/foot/foot.ini",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Binary {
                                left: Test(
                                    " -f $foot_config ",
                                ),
                                operator: And,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-qxF",
                                            "\\n[text-bindings]",
                                            "$foot_config",
                                        ],
                                    },
                                ),
                            },
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sed",
                                    args: [
                                        "-i",
                                        "/^\\\\n\\[text-bindings\\]$/d",
                                        "$foot_config",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
