            body: "#!/bin/bash\npid=\n[[ -f $listener_file ]] && pid=$(cat \"$listener_file\")\n[[ -z $pid && -f $unit ]] && pid=4242\n[[ -n $pid ]] && echo \"LISTEN 0 511 127.0.0.1:18789 0.0.0.0:* users:((\\\"node\\\",pid=$pid,fd=3))\"\nexit 0\n",
