            body: "{ \"type\": \"message\", \"id\": \"omp-1\", \"timestamp\": \"$timestamp\", \"message\": { \"role\": \"assistant\", \"provider\": \"openai-codex\", \"model\": \"gpt-omp\", \"usage\": { \"input\": 20, \"output\": 5, \"cacheRead\": 4, \"cacheWrite\": 1, \"totalTokens\": 30 } } }\n{\"type\":\"message\",\"id\":\"other-1\",\"timestamp\":\"$timestamp\",\"message\":{\"role\":\"assistant\",\"provider\":\"anthropic\",\"model\":\"claude-test\",\"usage\":{\"input\":999,\"output\":999}}}\n",
