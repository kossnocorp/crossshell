---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/fixtures/privileged-heredoc/shutdown-unit-home-execstop.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Installing Plymouth...",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "yay",
                args: [
                    "-S",
                    "--noconfirm",
                    "--needed",
                    "plymouth",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Negated(
                                Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-q",
                                            "plymouth",
                                            "/etc/mkinitcpio.conf",
                                        ],
                                    },
                                ),
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "backup_timestamp",
                                            value: "$(date +\"%Y%m%d%H%M%S\")",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "cp",
                                        "/etc/mkinitcpio.conf",
                                        "/etc/mkinitcpio.conf.bak.${backup_timestamp}",
                                    ],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "grep",
                                                        args: [
                                                            "-q",
                                                            "systemd",
                                                            "/etc/mkinitcpio.conf",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "sudo",
                                                        args: [
                                                            "sed",
                                                            "-i",
                                                            "/^HOOKS=/s/systemd/systemd plymouth/",
                                                            "/etc/mkinitcpio.conf",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "grep",
                                                        args: [
                                                            "-q",
                                                            "udev",
                                                            "/etc/mkinitcpio.conf",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "sudo",
                                                        args: [
                                                            "sed",
                                                            "-i",
                                                            "/^HOOKS=/s/udev/udev plymouth/",
                                                            "/etc/mkinitcpio.conf",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: Some(
                                    CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "sudo",
                                                    args: [
                                                        "sed",
                                                        "-i",
                                                        "/^HOOKS=/s/base/base plymouth/",
                                                        "/etc/mkinitcpio.conf",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                ),
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "sudo",
                args: [
                    "mkinitcpio",
                    "-P",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "[",
                                    args: [
                                        "-d",
                                        "/boot/loader/entries",
                                        "]",
                                    ],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "echo",
                                    args: [
                                        "Detected systemd-boot",
                                    ],
                                },
                            ),
                            For {
                                variable: "entry",
                                words: Some(
                                    [
                                        "/boot/loader/entries/*.conf",
                                    ],
                                ),
                                body: CshAst {
                                    commands: [
                                        If {
                                            branches: [
                                                CshAstBranch {
                                                    condition: CshAst {
                                                        commands: [
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [],
                                                                    name: "[",
                                                                    args: [
                                                                        "-f",
                                                                        "$entry",
                                                                        "]",
                                                                    ],
                                                                },
                                                            ),
                                                        ],
                                                    },
                                                    body: CshAst {
                                                        commands: [
                                                            If {
                                                                branches: [
                                                                    CshAstBranch {
                                                                        condition: CshAst {
                                                                            commands: [
                                                                                Test(
                                                                                    " \"$(basename \"$entry\")\" == *\"fallback\"* ",
                                                                                ),
                                                                            ],
                                                                        },
                                                                        body: CshAst {
                                                                            commands: [
                                                                                Command(
                                                                                    CshAstCommand {
                                                                                        assignments: [],
                                                                                        name: "echo",
                                                                                        args: [
                                                                                            "Skipped: $(basename \"$entry\") (fallback entry)",
                                                                                        ],
                                                                                    },
                                                                                ),
                                                                                Command(
                                                                                    CshAstCommand {
                                                                                        assignments: [],
                                                                                        name: "continue",
                                                                                        args: [],
                                                                                    },
                                                                                ),
                                                                            ],
                                                                        },
                                                                    },
                                                                ],
                                                                otherwise: None,
                                                            },
                                                            If {
                                                                branches: [
                                                                    CshAstBranch {
                                                                        condition: CshAst {
                                                                            commands: [
                                                                                Negated(
                                                                                    Command(
                                                                                        CshAstCommand {
                                                                                            assignments: [],
                                                                                            name: "grep",
                                                                                            args: [
                                                                                                "-q",
                                                                                                "splash",
                                                                                                "$entry",
                                                                                            ],
                                                                                        },
                                                                                    ),
                                                                                ),
                                                                            ],
                                                                        },
                                                                        body: CshAst {
                                                                            commands: [
                                                                                Command(
                                                                                    CshAstCommand {
                                                                                        assignments: [],
                                                                                        name: "sudo",
                                                                                        args: [
                                                                                            "sed",
                                                                                            "-i",
                                                                                            "/^options/ s/$/ splash quiet/",
                                                                                            "$entry",
                                                                                        ],
                                                                                    },
                                                                                ),
                                                                            ],
                                                                        },
                                                                    },
                                                                ],
                                                                otherwise: Some(
                                                                    CshAst {
                                                                        commands: [
                                                                            Command(
                                                                                CshAstCommand {
                                                                                    assignments: [],
                                                                                    name: "echo",
                                                                                    args: [
                                                                                        "Skipped: $(basename \"$entry\") (splash already present)",
                                                                                    ],
                                                                                },
                                                                            ),
                                                                        ],
                                                                    },
                                                                ),
                                                            },
                                                        ],
                                                    },
                                                },
                                            ],
                                            otherwise: None,
                                        },
                                    ],
                                },
                            },
                        ],
                    },
                },
            ],
            otherwise: Some(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "systemd-boot not detected. Please manually add these kernel parameters:",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "  - splash (to see the graphical splash screen)",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "  - quiet (for silent boot)",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "echo",
                                args: [
                                    "",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "touch",
                args: [
                    "$HOME/.config/omarchy/.plymouth-sync-needed",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "sudo",
                    args: [
                        "tee",
                        "/etc/systemd/system/omarchy-plymouth-shutdown.service",
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "/dev/null",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
                    here_document: 0,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "sudo",
                args: [
                    "systemctl",
                    "daemon-reload",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sudo",
                args: [
                    "systemctl",
                    "enable",
                    "omarchy-plymouth-shutdown.service",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sudo",
                args: [
                    "systemctl",
                    "start",
                    "omarchy-plymouth-shutdown.service",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            body: "[Unit]\nDescription=Sync Plymouth Theme on Shutdown\nDefaultDependencies=yes\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/true\nExecStop=$HOME/.local/share/omarchy/bin/omarchy-plymouth-shutdown-sync\n\n[Install]\nWantedBy=multi-user.target\n",
        },
    ],
}
