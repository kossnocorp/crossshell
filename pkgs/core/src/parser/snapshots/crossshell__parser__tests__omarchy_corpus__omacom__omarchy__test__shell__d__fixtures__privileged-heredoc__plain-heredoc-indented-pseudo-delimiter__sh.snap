---
CshAst {
    commands: [
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "/etc/omarchy/agent.conf",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
