                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "sudo",
                                                        args: [
                                                            "systemctl",
                                                            "enable",
                                                            "thermald.service",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
