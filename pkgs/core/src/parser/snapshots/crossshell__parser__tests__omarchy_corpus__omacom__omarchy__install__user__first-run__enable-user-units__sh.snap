---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/user/first-run/enable-user-units.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "systemctl",
                args: [
                    "--user",
                    "daemon-reload",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "systemctl",
                args: [
                    "--user",
                    "enable",
                    "--now",
                    "bt-agent.service",
                    "omarchy-recover-internal-monitor.service",
                    "omarchy-sleep-lock.service",
                    "omarchy-migrate-notify.service",
                    "omarchy-fcitx5.service",
                    "omarchy-crash-watch.service",
                ],
            },
        ),
    ],
}
