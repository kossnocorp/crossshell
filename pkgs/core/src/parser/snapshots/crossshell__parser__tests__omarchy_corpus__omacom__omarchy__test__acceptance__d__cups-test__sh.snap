---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/acceptance.d/cups-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        For {
            variable: "package",
            words: Some(
                [
                    "cups",
                    "cups-filters",
                    "system-config-printer",
                    "cups-pk-helper",
                ],
            ),
            body: CshAst {
                commands: [
                    Binary {
                        left: Redirected {
                            expression: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "pacman",
                                    args: [
                                        "-Q",
                                        "$package",
                                    ],
                                },
                            ),
                            redirects: [
                                CshAstRedirect {
                                    descriptor: None,
                                    operator: ">",
                                    target: "/dev/null",
                                },
                                CshAstRedirect {
                                    descriptor: Some(
                                        "2",
                                    ),
                                    operator: ">&",
                                    target: "1",
                                },
                            ],
                        },
                        operator: Or,
                        right: Command(
                            CshAstCommand {
                                assignments: [],
                                name: "fail",
                                args: [
                                    "printing packages are installed",
                                    "$package is missing",
                                ],
                            },
                        ),
                    },
                ],
            },
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "printing packages are installed",
                ],
            },
        ),
        Binary {
            left: Negated(
                Redirected {
                    expression: Command(
                        CshAstCommand {
                            assignments: [],
                            name: "pacman",
                            args: [
                                "-Q",
                                "cups-pdf",
                            ],
                        },
                    ),
                    redirects: [
                        CshAstRedirect {
                            descriptor: None,
                            operator: ">",
                            target: "/dev/null",
                        },
                        CshAstRedirect {
                            descriptor: Some(
                                "2",
                            ),
                            operator: ">&",
                            target: "1",
                        },
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "the root CUPS-PDF backend is absent",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "the root CUPS-PDF backend is absent",
                ],
            },
        ),
        Binary {
            left: Negated(
                Redirected {
                    expression: Command(
                        CshAstCommand {
                            assignments: [],
                            name: "pacman",
                            args: [
                                "-Q",
                                "cups-browsed",
                            ],
                        },
                    ),
                    redirects: [
                        CshAstRedirect {
                            descriptor: None,
                            operator: ">",
                            target: "/dev/null",
                        },
                        CshAstRedirect {
                            descriptor: Some(
                                "2",
                            ),
                            operator: ">&",
                            target: "1",
                        },
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "automatic printer discovery is absent",
                    ],
                },
            ),
        },
        Binary {
            left: Negated(
                Redirected {
                    expression: Command(
                        CshAstCommand {
                            assignments: [],
                            name: "systemctl",
                            args: [
                                "is-enabled",
                                "--quiet",
                                "cups-browsed.service",
                            ],
                        },
                    ),
                    redirects: [
                        CshAstRedirect {
                            descriptor: Some(
                                "2",
                            ),
                            operator: ">",
                            target: "/dev/null",
                        },
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "automatic printer discovery is not enabled",
                    ],
                },
            ),
        },
        Binary {
            left: Negated(
                Redirected {
                    expression: Command(
                        CshAstCommand {
                            assignments: [],
                            name: "systemctl",
                            args: [
                                "is-active",
                                "--quiet",
                                "cups-browsed.service",
                            ],
                        },
                    ),
                    redirects: [
                        CshAstRedirect {
                            descriptor: Some(
                                "2",
                            ),
                            operator: ">",
                            target: "/dev/null",
                        },
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "automatic printer discovery is not running",
                    ],
                },
            ),
        },
        Binary {
            left: Negated(
                Redirected {
                    expression: Command(
                        CshAstCommand {
                            assignments: [],
                            name: "pgrep",
                            args: [
                                "-x",
                                "cups-browsed",
                            ],
                        },
                    ),
                    redirects: [
                        CshAstRedirect {
                            descriptor: None,
                            operator: ">",
                            target: "/dev/null",
                        },
                        CshAstRedirect {
                            descriptor: Some(
                                "2",
                            ),
                            operator: ">&",
                            target: "1",
                        },
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "no cups-browsed process exists",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "automatic printer discovery is not installed or running",
                ],
            },
        ),
        For {
            variable: "path",
            words: Some(
                [
                    "/etc/cups/cups-browsed.conf",
                    "/etc/cups/cups-browsed.conf.pacsave",
                    "/etc/cups/cups-browsed.conf.pacnew",
                    "/usr/bin/cups-browsed",
                    "/usr/lib/cups/backend/implicitclass",
                    "/usr/lib/systemd/system/cups-browsed.service",
                    "/etc/systemd/system/multi-user.target.wants/cups-browsed.service",
                ],
            ),
            body: CshAst {
                commands: [
                    Binary {
                        left: Test(
                            " ! -e $path && ! -L $path ",
                        ),
                        operator: Or,
                        right: Command(
                            CshAstCommand {
                                assignments: [],
                                name: "fail",
                                args: [
                                    "automatic printer discovery leaves no package files",
                                    "$path still exists",
                                ],
                            },
                        ),
                    },
                ],
            },
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "automatic printer discovery leaves no package files",
                ],
            },
        ),
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [],
                    name: "systemctl",
                    args: [
                        "is-enabled",
                        "--quiet",
                        "cups.service",
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "CUPS is enabled",
                    ],
                },
            ),
        },
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [],
                    name: "systemctl",
                    args: [
                        "is-active",
                        "--quiet",
                        "cups.service",
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "CUPS is running",
                    ],
                },
            ),
        },
        Binary {
            left: Redirected {
                expression: Command(
                    CshAstCommand {
                        assignments: [],
                        name: "timeout",
                        args: [
                            "10",
                            "lpstat",
                            "-r",
                        ],
                    },
                ),
                redirects: [
                    CshAstRedirect {
                        descriptor: None,
                        operator: ">",
                        target: "/dev/null",
                    },
                    CshAstRedirect {
                        descriptor: Some(
                            "2",
                        ),
                        operator: ">&",
                        target: "1",
                    },
                ],
            },
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "the CUPS scheduler answers",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "CUPS is enabled, running, and answering",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "policy_metadata",
                        value: "$(stat -c '%U:%G %a' /etc/cups/cups-files.conf)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $policy_metadata == \"root:cups 640\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "the CUPS authorization policy is protected",
                        "$policy_metadata",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "the CUPS authorization policy is protected",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "lpinfo_output",
                                            value: "$(LC_ALL=C timeout 10 lpinfo -v </dev/null 2>&1)",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "the desktop user cannot administer CUPS without authentication",
                                    ],
                                },
                            ),
                        ],
                    },
                },
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " $lpinfo_output != *\"Forbidden\"* ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "CUPS explicitly denies unauthenticated desktop administration",
                                        "$lpinfo_output",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "CUPS denies unauthenticated desktop administration",
                ],
            },
        ),
    ],
}
