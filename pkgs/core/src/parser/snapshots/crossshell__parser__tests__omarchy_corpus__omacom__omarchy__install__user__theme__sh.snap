---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/user/theme.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "~/.config/omarchy/themes",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " ! -s $HOME/.local/state/omarchy/current/theme.name ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " ${OMARCHY_SETUP_CONTEXT:-runtime} != \"runtime\" ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "OMARCHY_THEME_HEADLESS",
                                                                value: "1",
                                                            },
                                                        ],
                                                        name: "omarchy-theme-set",
                                                        args: [
                                                            "Tokyo Night",
                                                        ],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "rm",
                                                        args: [
                                                            "-f",
                                                            "~/.config/chromium/SingletonLock",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: Some(
                                    CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "omarchy-theme-set",
                                                    args: [
                                                        "Tokyo Night",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                ),
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "omarchy-theme-set-pi",
                args: [
                    "--activate",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "~/.config/btop/themes",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "ln",
                args: [
                    "-snf",
                    "$HOME/.local/state/omarchy/current/theme/btop.theme",
                    "~/.config/btop/themes/current.theme",
                ],
            },
        ),
    ],
}
