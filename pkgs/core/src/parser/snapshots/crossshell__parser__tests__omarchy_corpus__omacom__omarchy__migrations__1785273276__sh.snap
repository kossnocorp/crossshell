---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/migrations/1785273276.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Rename the T2 Mac BCE module (apple-bce → t2bce) and repair the boot image",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "conf",
                        value: "${OMARCHY_T2_MKINITCPIO_CONF:-/etc/mkinitcpio.conf.d/apple-t2.conf}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "modules_conf",
                        value: "${OMARCHY_T2_MODULES_CONF:-/etc/modules-load.d/t2.conf}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Binary {
                                left: Test(
                                    " -f $conf ",
                                ),
                                operator: And,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-q",
                                            "apple-bce ",
                                            "$conf",
                                        ],
                                    },
                                ),
                            },
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "sed",
                                        "-i",
                                        "s/apple-bce /apple-bce? t2bce_vhci? /",
                                        "$conf",
                                    ],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " -f $modules_conf ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "sudo",
                                                        args: [
                                                            "sed",
                                                            "-i",
                                                            "s/^apple-bce$/t2bce_vhci/",
                                                            "$modules_conf",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "limine-update",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
