            body: "#!/bin/bash\n\nprintf 'shell %s\\n' \"$*\" >>\"$CALL_LOG\"\n\nif [[ $* == \"lock lock\" ]]; then\n  exit 1\nfi\n\nif [[ $* == \"lock status\" ]]; then\n  if [[ -f $STATE_DIR/pending_seen ]]; then\n    printf '{\"secure\":true}\\n'\n  else\n    touch \"$STATE_DIR/pending_seen\"\n    printf '{\"secure\":false,\"requested\":true,\"pending\":true,\"sessionLocked\":false}\\n'\n  fi\nfi\n",
        },
