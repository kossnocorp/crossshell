        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "$(dirname \"$SNAPPER_CONF_PATH\")",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
