                                                            descriptor: None,
                                                            operator: ">",
                                                            target: "/dev/null",
                                                        },
                                                        CshAstRedirect {
                                                            descriptor: Some(
                                                                "2",
                                                            ),
                                                            operator: ">&",
                                                            target: "1",
                                                        },
                                                    ],
                                                },
                                                operator: Or,
                                                right: Redirected {
                                                    expression: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "snapper",
                                                            args: [
                                                                "-c",
                                                                "root",
                                                                "create-config",
                                                                "/",
                                                            ],
                                                        },
                                                    ),
                                                    redirects: [
