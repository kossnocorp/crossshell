            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "true",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Binary {
                                left: Redirected {
                                    expression: Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "cat",
                                            args: [],
                                        },
                                    ),
                                    redirects: [
                                        CshAstRedirect {
                                            descriptor: None,
                                            operator: "<<-",
                                            target: "EOF",
                                            here_document: 0,
