                                    "name",
                                    "command",
                                    "class",
                                    "timeout",
                                ],
                            },
                        ),
                    ],
                },
                body: CshAst {
                    commands: [
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Negated(
                                                Subshell(
                                                    CshAst {
                                                        commands: [
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [],
                                                                    name: "launch_and_verify",
                                                                    args: [
                                                                        "$name",
                                                                        "$command",
                                                                        "$class",
                                                                        "$timeout",
                                                                    ],
                                                                },
                                                            ),
                                                        ],
                                                    },
                                                ),
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "status",
                                                            value: "1",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                    ],
                },
            },
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<<",
                    target: "$apps",
