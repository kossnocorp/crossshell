                assignments: [
                    CshAstAssignment {
                        name: "apps",
                        value: "terminal|foot|^foot$\nbrowser|chromium --new-window|(?i)chromium\nneovim|xdg-terminal-exec --app-id=org.omarchy.nvim nvim|org.omarchy.nvim\nwriter|omawrite|(?i)omawrite",
