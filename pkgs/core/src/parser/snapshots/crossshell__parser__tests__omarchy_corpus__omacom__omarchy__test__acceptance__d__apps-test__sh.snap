                                args: [
                                    "name=$1",
                                    "command=$2",
                                    "class=$3",
                                    "timeout=${4:-45}",
                                ],
                            },
                        ),
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
