                                                    args: [
                                                        "$name starts with no pre-existing window",
                                                        "a window matching $class is already open",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "launch_app",
                                args: [
                                    "$command",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "wait_until",
                                args: [
                                    "$name opens a window",
                                    "$timeout",
                                    "window_present",
                                    "$class",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "sleep",
                                args: [
                                    "1",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "screenshot",
                                args: [
                                    "success-app-$name",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "deadline=$((SECONDS + 30))",
                                ],
                            },
                        ),
                        Loop {
                            until: false,
                            condition: CshAst {
                                commands: [
                                    Redirected {
                                        expression: Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "window_present",
                                                args: [
                                                    "$class",
                                                ],
                                            },
                                        ),
                                        redirects: [
                                            CshAstRedirect {
                                                descriptor: None,
                                                operator: ">",
                                                target: "/dev/null",
                                            },
                                            CshAstRedirect {
                                                descriptor: Some(
                                                    "2",
                                                ),
                                                operator: ">&",
                                                target: "1",
                                            },
                                        ],
                                    },
                                ],
                            },
                            body: CshAst {
                                commands: [
                                    Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "close_windows",
                                            args: [
                                                "$class",
                                            ],
                                        },
                                    ),
                                    If {
                                        branches: [
                                            CshAstBranch {
                                                condition: CshAst {
                                                    commands: [
                                                        Arithmetic(
                                                            "SECONDS >= deadline",
                                                        ),
                                                    ],
                                                },
                                                body: CshAst {
                                                    commands: [
                                                        Command(
                                                            CshAstCommand {
                                                                assignments: [],
                                                                name: "fail",
                                                                args: [
                                                                    "$name window closes",
                                                                ],
                                                            },
                                                        ),
                                                    ],
                                                },
                                            },
                                        ],
                                        otherwise: None,
                                    },
                                    Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "sleep",
                                            args: [
                                                "2",
                                            ],
                                        },
                                    ),
                                ],
                            },
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "$name window closes",
                                ],
