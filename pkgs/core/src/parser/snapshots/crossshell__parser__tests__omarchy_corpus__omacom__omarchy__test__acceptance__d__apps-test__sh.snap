                                                        descriptor: None,
                                                        operator: ">",
                                                        target: "/dev/null",
                                                    },
                                                    CshAstRedirect {
                                                        descriptor: Some(
                                                            "2",
                                                        ),
                                                        operator: ">&",
                                                        target: "1",
                                                    },
                                                ],
                                            },
                                        ],
