    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "run_node_test",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "JS",
                    here_document: 0,
                },
