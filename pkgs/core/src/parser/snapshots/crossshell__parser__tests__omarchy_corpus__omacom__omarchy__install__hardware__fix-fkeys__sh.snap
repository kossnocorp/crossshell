---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/hardware/fix-fkeys.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " ! -f /etc/modprobe.d/hid_apple.conf ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "mkdir",
                                        "-p",
                                        "/etc/modprobe.d",
                                    ],
                                },
                            ),
                            Binary {
                                left: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "echo",
                                        args: [
                                            "options hid_apple fnmode=2",
                                        ],
                                    },
                                ),
                                operator: Pipe,
                                right: Redirected {
                                    expression: Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "sudo",
                                            args: [
                                                "tee",
                                                "/etc/modprobe.d/hid_apple.conf",
                                            ],
                                        },
                                    ),
                                    redirects: [
                                        CshAstRedirect {
                                            descriptor: None,
                                            operator: ">",
                                            target: "/dev/null",
                                        },
                                    ],
                                },
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
