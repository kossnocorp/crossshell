        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "ffmpeg",
                args: [
                    "-y",
                    "-f",
                    "lavfi",
                    "-i",
                    "testsrc=size=640x360:rate=10:duration=2",
                    "-vf",
                    "drawbox=x=0:y=0:w=640:h=40:color=0xf5f5f5:t=fill",
                    "-c:v",
                    "libx264",
                    "-preset",
                    "ultrafast",
                    "-pix_fmt",
                    "yuv420p",
                    "$light_top_video",
                    "-loglevel",
                    "error",
