            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "dark_top",
                        value: "$TMPDIR/dark-top.png",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "magick",
                args: [
                    "-size",
                    "100x100",
                    "xc:#202020",
                    "-fill",
                    "#f5f5f5",
                    "-draw",
                    "rectangle 0,0 99,19",
                    "$light_top",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "magick",
                args: [
                    "-size",
                    "100x100",
                    "xc:#f5f5f5",
                    "-fill",
                    "#202020",
                    "-draw",
                    "rectangle 0,0 99,19",
                    "$dark_top",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "result",
                        value: "$(HOME=\"$TMPDIR\" omarchy-bar-text-color top 20 '#ffffff' '#101010' --background \"$light_top\" --screen 100x100)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $result == \"#101010\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "transparent bar text switches to background color on light wallpaper",
                        "expected #101010, got $result",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "transparent bar text switches to background color on light wallpaper",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "result",
                        value: "$(HOME=\"$TMPDIR\" omarchy-bar-text-color top 20 '#ffffff' '#101010' --background \"$dark_top\" --screen 100x100)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $result == \"#ffffff\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "transparent bar text keeps text color on dark wallpaper",
