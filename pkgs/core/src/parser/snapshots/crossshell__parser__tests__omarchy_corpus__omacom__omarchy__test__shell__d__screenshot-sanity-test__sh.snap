            strip_tabs: false,
            body: "#!/bin/bash\n\ncase \"${*: -1}\" in\n  *'?format=j1')\n    printf '{\"current_condition\":[{\"weatherCode\":\"113\",\"temp_F\":\"72\"}]}\\n'\n    ;;\n  *'?format=%l')\n    printf 'Test City, Test Region\\n'\n    ;;\n  *)\n    exit 1\n    ;;\nesac\n",
