                            operator: Or,
                            right: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "keyboard-interactive authentication is off",
                                    ],
                                },
                            ),
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "keyboard-interactive authentication is off",
                                ],
                            },
                        ),
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "omarchy-cmd-present",
                                                    args: [
                                                        "ufw",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Binary {
                                                left: Binary {
                                                    left: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "sudo",
                                                            args: [
                                                                "-n",
                                                                "ufw",
                                                                "status",
                                                            ],
                                                        },
                                                    ),
                                                    operator: Pipe,
                                                    right: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "grep",
                                                            args: [
                                                                "-qE",
                                                                "^22/tcp\\s+LIMIT",
                                                            ],
                                                        },
                                                    ),
                                                },
                                                operator: Or,
                                                right: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "fail",
                                                        args: [
                                                            "the SSH port is rate limited in the firewall",
                                                        ],
                                                    },
                                                ),
                                            },
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "pass",
                                                    args: [
                                                        "the SSH port is rate limited in the firewall",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "sed",
                                args: [
                                    "-i",
                                    "\\#$(cat \"$key_file.pub\" | cut -d' ' -f2)#d",
                                    "$HOME/.ssh/authorized_keys",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "rm",
                                args: [
                                    "-f",
                                    "$key_file",
                                    "$key_file.pub",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "verify_input_group",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo_available",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "verify_asdcontrol_sudoers",
                                    args: [],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: Some(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "asdcontrol sudoers check skipped: sudo needs a password",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Binary {
                                left: Test(
                                    " -n ${OMARCHY_ACCEPTANCE_SUDO_PASSWORD:-} ",
                                ),
                                operator: And,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "sudo_available",
                                        args: [],
                                    },
                                ),
                            },
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "verify_sshd_hardening",
                                    args: [],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: Some(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "sshd hardening exercise skipped: set OMARCHY_ACCEPTANCE_SUDO_PASSWORD to run it",
                                ],
                            },
