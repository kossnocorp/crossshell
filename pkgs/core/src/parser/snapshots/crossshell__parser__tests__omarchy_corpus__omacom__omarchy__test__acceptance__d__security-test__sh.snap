                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "effective_config",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "rm",
                                args: [
                                    "-f",
                                    "$key_file",
                                    "$key_file.pub",
