---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/acceptance.d/security-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Function {
            name: "verify_input_group",
            body: Group(
                CshAst {
                    commands: [
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Binary {
                                                left: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "id",
                                                        args: [
                                                            "-nG",
                                                        ],
                                                    },
                                                ),
                                                operator: Pipe,
                                                right: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "grep",
                                                        args: [
                                                            "-qw",
                                                            "input",
                                                        ],
                                                    },
                                                ),
                                            },
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            If {
                                                branches: [
                                                    CshAstBranch {
                                                        condition: CshAst {
                                                            commands: [
                                                                Binary {
                                                                    left: Redirected {
                                                                        expression: Command(
                                                                            CshAstCommand {
                                                                                assignments: [],
                                                                                name: "pacman",
                                                                                args: [
                                                                                    "-Q",
                                                                                    "xpadneo-dkms",
                                                                                ],
                                                                            },
                                                                        ),
                                                                        redirects: [
                                                                            CshAstRedirect {
                                                                                descriptor: None,
                                                                                operator: "&>",
                                                                                target: "/dev/null",
                                                                            },
                                                                        ],
                                                                    },
                                                                    operator: Or,
                                                                    right: Redirected {
                                                                        expression: Command(
                                                                            CshAstCommand {
                                                                                assignments: [],
                                                                                name: "pacman",
                                                                                args: [
                                                                                    "-Q",
                                                                                    "ydotool",
                                                                                ],
                                                                            },
                                                                        ),
                                                                        redirects: [
                                                                            CshAstRedirect {
                                                                                descriptor: None,
                                                                                operator: "&>",
                                                                                target: "/dev/null",
                                                                            },
                                                                        ],
                                                                    },
                                                                },
                                                            ],
                                                        },
                                                        body: CshAst {
                                                            commands: [
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [],
                                                                        name: "pass",
                                                                        args: [
                                                                            "input group membership is backed by an opt-in feature",
                                                                        ],
                                                                    },
                                                                ),
                                                            ],
                                                        },
                                                    },
                                                ],
                                                otherwise: Some(
                                                    CshAst {
                                                        commands: [
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [],
                                                                    name: "fail",
                                                                    args: [
                                                                        "user is not in the input group",
                                                                        "no controller or ydotool support installed to justify it",
                                                                    ],
                                                                },
                                                            ),
                                                        ],
                                                    },
                                                ),
                                            },
                                        ],
                                    },
                                },
                            ],
                            otherwise: Some(
                                CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "pass",
                                                args: [
                                                    "user is not in the input group",
                                                ],
                                            },
                                        ),
                                    ],
                                },
                            ),
                        },
                    ],
                },
            ),
        },
        Function {
            name: "sudo_available",
            body: Group(
                CshAst {
                    commands: [
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
