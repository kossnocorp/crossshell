                    ],
                },
            ),
        },
        Function {
            name: "verify_sshd_hardening",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "key_file=/tmp/omarchy-acceptance-sshd-key",
                                ],
