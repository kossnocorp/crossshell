                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "ssh-keygen",
                                args: [
                                    "-t",
                                    "ed25519",
                                    "-N",
                                    "",
                                    "-q",
                                    "-C",
                                    "omarchy-acceptance",
                                    "-f",
                                    "$key_file",
                                ],
                            },
                        ),
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Negated(
                                                Redirected {
                                                    expression: Command(
                                                        CshAstCommand {
                                                            assignments: [
                                                                CshAstAssignment {
                                                                    name: "OMARCHY_ACCEPTANCE_SUDO_PASSWORD",
                                                                    value: "$OMARCHY_ACCEPTANCE_SUDO_PASSWORD",
                                                                },
                                                                CshAstAssignment {
                                                                    name: "OMARCHY_ACCEPTANCE_SSHD_KEY",
                                                                    value: "$(cat \"$key_file.pub\")",
                                                                },
                                                                CshAstAssignment {
                                                                    name: "SHELL",
                                                                    value: "/bin/bash",
                                                                },
                                                            ],
                                                            name: "script",
                                                            args: [
                                                                "-qec",
                                                                "printf \"%s\\n\" \"$OMARCHY_ACCEPTANCE_SUDO_PASSWORD\" | sudo -S -v 2>/dev/null &&\n      omarchy-setup-security-sshd --key=\"$OMARCHY_ACCEPTANCE_SSHD_KEY\"",
                                                                "/dev/null",
                                                            ],
                                                        },
                                                    ),
                                                    redirects: [
                                                        CshAstRedirect {
                                                            descriptor: None,
                                                            operator: "<",
                                                            target: "/dev/null",
                                                        },
                                                        CshAstRedirect {
                                                            descriptor: None,
                                                            operator: ">",
                                                            target: "$ARTIFACTS/setup-security-sshd.log",
                                                        },
                                                        CshAstRedirect {
                                                            descriptor: Some(
                                                                "2",
                                                            ),
                                                            operator: ">&",
                                                            target: "1",
                                                        },
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "fail",
                                                    args: [
                                                        "omarchy-setup-security-sshd completes unattended",
                                                        "$(tail -5 \"$ARTIFACTS/setup-security-sshd.log\")",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "omarchy-setup-security-sshd completes unattended",
                                ],
                            },
