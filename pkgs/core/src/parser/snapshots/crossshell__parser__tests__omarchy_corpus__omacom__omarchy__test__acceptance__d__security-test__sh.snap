                            operator: Or,
                            right: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "the key is authorized",
                                    ],
                                },
                            ),
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "the key is authorized",
                                ],
                            },
                        ),
                        Binary {
                            left: Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "effective_config",
                                            value: "$(sudo -n sshd -T)",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            operator: Or,
                            right: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "sshd reports its effective config",
                                    ],
                                },
                            ),
                        },
                        Binary {
                            left: Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-qixF",
                                            "passwordauthentication no",
                                        ],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: "<<<",
                                        target: "$effective_config",
                                    },
                                ],
                            },
                            operator: Or,
                            right: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "password authentication is off",
                                    ],
                                },
                            ),
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "password authentication is off",
                                ],
                            },
                        ),
                        Binary {
                            left: Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-qixF",
                                            "kbdinteractiveauthentication no",
                                        ],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: "<<<",
                                        target: "$effective_config",
                                    },
