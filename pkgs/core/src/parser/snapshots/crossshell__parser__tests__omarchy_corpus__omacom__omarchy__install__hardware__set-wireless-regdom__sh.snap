---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/hardware/set-wireless-regdom.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "regdom_file",
                        value: "/etc/conf.d/wireless-regdom",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " -f $regdom_file ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "grep",
                                    args: [
                                        "-q",
                                        "^WIRELESS_REGDOM=",
                                        "$regdom_file",
                                    ],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "exit",
                                    args: [
                                        "0",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "timezone",
                        value: "",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -e /etc/localtime ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "timezone",
                                            value: "$(readlink -f /etc/localtime || true)",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "timezone",
                                            value: "${timezone#/usr/share/zoneinfo/}",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "country",
                        value: "${timezone%%/*}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "zone_tab",
                        value: "/usr/share/zoneinfo/zone.tab",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " ! $country =~ ^[A-Z]{2}$ && -n $timezone && -f $zone_tab ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "country",
                                            value: "$(awk -v tz=\"$timezone\" '$3 == tz {print $1; exit}' \"$zone_tab\")",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " $country =~ ^[A-Z]{2}$ ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Binary {
                                left: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "echo",
                                        args: [
                                            "WIRELESS_REGDOM=\"$country\"",
                                        ],
                                    },
                                ),
                                operator: Pipe,
                                right: Redirected {
                                    expression: Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "sudo",
                                            args: [
                                                "tee",
                                                "-a",
                                                "$regdom_file",
                                            ],
                                        },
                                    ),
                                    redirects: [
                                        CshAstRedirect {
                                            descriptor: None,
                                            operator: ">",
                                            target: "/dev/null",
                                        },
                                    ],
                                },
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
