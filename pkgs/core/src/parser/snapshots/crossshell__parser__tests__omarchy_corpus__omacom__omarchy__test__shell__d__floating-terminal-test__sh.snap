---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/floating-terminal-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "tmp_dir",
                        value: "$(mktemp -d)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "trap",
                args: [
                    "rm -rf \"$tmp_dir\"",
                    "EXIT",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$tmp_dir/setsid",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "SCRIPT",
                    here_document: 0,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "chmod",
                args: [
                    "+x",
                    "$tmp_dir/setsid",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "TEST_LOG=$tmp_dir/log",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "PATH=$tmp_dir:$ROOT/bin:$PATH",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "$ROOT/bin/omarchy-launch-floating-terminal-with-presentation",
                args: [
                    "echo hello",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "launch",
                        value: "$(<\"$TEST_LOG\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $launch == *\"xdg-terminal-exec --app-id=org.omarchy.terminal\"* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "floating terminal launches Omarchy terminal",
                        "$launch",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "floating terminal launches Omarchy terminal",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "SCRIPT",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nprintf '%s\\n' \"$*\" >\"$TEST_LOG\"\n",
        },
    ],
}
