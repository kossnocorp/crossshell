---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/login/sddm.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -f /etc/pam.d/sddm ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sed",
                                    args: [
                                        "-i",
                                        "/-auth.*pam_gnome_keyring\\.so/d",
                                        "/etc/pam.d/sddm",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sed",
                                    args: [
                                        "-i",
                                        "/-password.*pam_gnome_keyring\\.so/d",
                                        "/etc/pam.d/sddm",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
