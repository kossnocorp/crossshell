    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "gsettings",
                args: [
                    "set",
                    "org.gnome.desktop.interface",
                    "gtk-enable-primary-paste",
                    "true",
                ],
            },
        ),
    ],
}
