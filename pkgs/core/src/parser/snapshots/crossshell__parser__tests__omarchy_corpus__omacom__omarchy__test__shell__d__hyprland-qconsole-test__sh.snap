            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "require_command",
                args: [
                    "lua",
                ],
            },
        ),
        Binary {
            left: Redirected {
                expression: Command(
                    CshAstCommand {
                        assignments: [
                            CshAstAssignment {
                                name: "OMARCHY_PATH",
                                value: "$ROOT",
                            },
                        ],
                        name: "lua",
                        args: [
                            "-",
                        ],
                    },
                ),
                redirects: [
                    CshAstRedirect {
                        descriptor: None,
                        operator: "<<",
                        target: "LUA",
                        here_document: 0,
