            body: "{\n  \"schemaVersion\": 1,\n  \"id\": \"$victim_service_id\",\n  \"name\": \"Victim Service\",\n  \"version\": \"1.0.0\",\n  \"kinds\": [\"service\"],\n  \"entryPoints\": {\"service\": \"Service.qml\"}\n}\n",
