                                                                ],
                                                            },
                                                        },
                                                    ],
                                                    otherwise: Some(
                                                        CshAst {
                                                            commands: [
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [],
                                                                        name: "delims+=(\"$raw\")",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [],
                                                                        name: "quoted+=(1)",
                                                                        args: [],
                                                                    },
                                                                ),
                                                            ],
                                                        },
                                                    ),
                                                },
                                                Binary {
                                                    left: Binary {
                                                        left: Test(
                                                            " $operator == \"<<-\" ",
                                                        ),
                                                        operator: And,
                                                        right: Command(
                                                            CshAstCommand {
                                                                assignments: [],
                                                                name: "strip_tabs+=(1)",
                                                                args: [],
                                                            },
                                                        ),
                                                    },
                                                    operator: Or,
                                                    right: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "strip_tabs+=(0)",
                                                            args: [],
                                                        },
                                                    ),
                                                },
                                            ],
                                        },
                                    },
                                    Binary {
                                        left: Arithmetic(
                                            "${#delims[@]} > 0",
                                        ),
                                        operator: Or,
                                        right: Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "continue",
                                                args: [],
                                            },
                                        ),
                                    },
                                    For {
                                        variable: "slot",
                                        words: Some(
                                            [
                                                "${!delims[@]}",
                                            ],
                                        ),
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "delim",
                                                                value: "${delims[slot]}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
