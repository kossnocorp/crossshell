                                    Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "printf",
                                            args: [
                                                "%s",
                                                "${names[*]}",
                                            ],
                                        },
                                    ),
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        Function {
            name: "inside_same_line_arithmetic",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "prefix=$1",
                                    "opens=0",
                                    "closes=0",
                                ],
                            },
                        ),
                        Loop {
                            until: false,
                            condition: CshAst {
                                commands: [
                                    Test(
                                        " $prefix == *\"((\"* ",
                                    ),
                                ],
                            },
                            body: CshAst {
                                commands: [
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "opens",
                                                    value: "$((opens + 1))",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "prefix",
                                                    value: "${prefix#*\"((\"}",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                ],
                            },
                        },
                        Loop {
                            until: false,
                            condition: CshAst {
                                commands: [
                                    Test(
                                        " $prefix == *\"))\"* ",
                                    ),
                                ],
                            },
                            body: CshAst {
                                commands: [
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "closes",
                                                    value: "$((closes + 1))",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "prefix",
                                                    value: "${prefix#*\"))\"}",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                ],
                            },
                        },
                        Arithmetic(
                            "opens > closes",
                        ),
                    ],
                },
            ),
        },
        Function {
            name: "scan_file",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "file=$1",
                                    "display=${2:-$1}",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "-a",
                                    "lines=()",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "index",
                                    "lineno",
                                    "line",
                                    "command",
                                    "scan",
                                    "rest",
                                    "raw",
                                    "operator",
                                    "match",
                                    "prefix",
                                    "guard",
                                    "slot",
                                    "delim",
                                    "candidate",
                                    "candidate_delim",
                                    "body_start",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "body_text",
                                    "unescaped",
                                    "destination",
                                    "destination_command",
                                    "body_line",
                                    "masked_line",
                                    "token",
                                    "name",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "declared_paths",
                                    "annotation",
                                    "look",
                                    "shown_paths",
                                    "shown_plain",
                                    "count",
                                    "next",
                                    "slots",
                                    "terminated",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "hd_re=(<<-?)[[:space:]]*(\"[A-Za-z_][A-Za-z0-9_]*\"|'[A-Za-z_][A-Za-z0-9_]*'|[A-Za-z_][A-Za-z0-9_]*)",
                                ],
                            },
                        ),
                        Redirected {
                            expression: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "mapfile",
                                    args: [
                                        "-t",
                                        "lines",
                                    ],
                                },
                            ),
                            redirects: [
                                CshAstRedirect {
                                    descriptor: None,
                                    operator: "<",
                                    target: "$file",
                                },
                            ],
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "collect_vars",
                                args: [
                                    "lines",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [
                                    CshAstAssignment {
                                        name: "index",
                                        value: "0",
                                    },
                                ],
                                name: "",
                                args: [],
                            },
                        ),
                        Loop {
                            until: false,
                            condition: CshAst {
                                commands: [
                                    Arithmetic(
                                        "index < ${#lines[@]}",
                                    ),
                                ],
                            },
                            body: CshAst {
                                commands: [
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "line",
                                                    value: "${lines[index]}",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "lineno",
                                                    value: "$((index + 1))",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "index",
                                                    value: "$((index + 1))",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Binary {
                                        left: Test(
                                            " $line =~ ^[[:space:]]*# ",
                                        ),
                                        operator: And,
                                        right: Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "continue",
                                                args: [],
                                            },
                                        ),
                                    },
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "command",
                                                    value: "$line",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Loop {
                                        until: false,
                                        condition: CshAst {
                                            commands: [
                                                Binary {
                                                    left: Test(
                                                        " $command == *\\\\ ",
                                                    ),
                                                    operator: And,
                                                    right: Arithmetic(
                                                        "index < ${#lines[@]}",
                                                    ),
                                                },
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "command",
                                                                value: "${command%\\\\}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "command+= ${lines[index]}",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "index",
                                                                value: "$((index + 1))",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "scan",
                                                    value: "${command//<<</   }",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Binary {
                                        left: Test(
                                            " $scan == *\"<<\"* ",
                                        ),
                                        operator: Or,
                                        right: Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "continue",
                                                args: [],
                                            },
                                        ),
                                    },
                                    Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "local",
                                            args: [
                                                "-a",
                                                "delims=()",
                                                "quoted=()",
                                                "strip_tabs=()",
