                                    Binary {
                                        left: Arithmetic(
                                            "next < ${#source_lines[@]}",
                                        ),
                                        operator: Or,
                                        right: Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "break",
                                                args: [],
                                            },
