                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "guard",
                                                    value: "0",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                    Loop {
                                        until: false,
                                        condition: CshAst {
                                            commands: [
                                                Binary {
                                                    left: Arithmetic(
                                                        "guard++ < 8",
                                                    ),
                                                    operator: And,
                                                    right: Test(
                                                        " $rest =~ $hd_re ",
                                                    ),
                                                },
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "match",
                                                                value: "${BASH_REMATCH[0]}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "operator",
                                                                value: "${BASH_REMATCH[1]}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "raw",
                                                                value: "${BASH_REMATCH[2]}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "prefix",
                                                                value: "${rest%%\"$match\"*}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "rest",
                                                                value: "${rest#*\"$match\"}",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Binary {
                                                    left: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "inside_same_line_arithmetic",
                                                            args: [
                                                                "$prefix",
                                                            ],
                                                        },
                                                    ),
                                                    operator: And,
                                                    right: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "continue",
                                                            args: [],
                                                        },
                                                    ),
                                                },
                                                If {
                                                    branches: [
                                                        CshAstBranch {
                                                            condition: CshAst {
                                                                commands: [
                                                                    Test(
                                                                        " $raw == \\\"*\\\" || $raw == \\'*\\' ",
                                                                    ),
                                                                ],
                                                            },
                                                            body: CshAst {
                                                                commands: [
                                                                    Command(
                                                                        CshAstCommand {
                                                                            assignments: [],
                                                                            name: "delims+=(\"${raw:1:${#raw}-2}\")",
                                                                            args: [],
                                                                        },
                                                                    ),
                                                                    Command(
                                                                        CshAstCommand {
                                                                            assignments: [],
                                                                            name: "quoted+=(0)",
                                                                            args: [],
                                                                        },
