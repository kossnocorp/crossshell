                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "body_start",
                                                                value: "$index",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "terminated",
                                                                value: "1",
                                                            },
                                                        ],
                                                        name: "",
                                                        args: [],
                                                    },
                                                ),
                                                Loop {
                                                    until: false,
                                                    condition: CshAst {
                                                        commands: [
                                                            Arithmetic(
                                                                "index < ${#lines[@]}",
                                                            ),
                                                        ],
                                                    },
                                                    body: CshAst {
                                                        commands: [
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [
                                                                        CshAstAssignment {
                                                                            name: "candidate",
                                                                            value: "${lines[index]}",
                                                                        },
                                                                    ],
                                                                    name: "",
                                                                    args: [],
                                                                },
                                                            ),
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [
                                                                        CshAstAssignment {
                                                                            name: "index",
                                                                            value: "$((index + 1))",
                                                                        },
                                                                    ],
                                                                    name: "",
                                                                    args: [],
                                                                },
                                                            ),
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [
                                                                        CshAstAssignment {
                                                                            name: "candidate_delim",
                                                                            value: "$candidate",
                                                                        },
                                                                    ],
                                                                    name: "",
                                                                    args: [],
                                                                },
                                                            ),
                                                            If {
                                                                branches: [
                                                                    CshAstBranch {
                                                                        condition: CshAst {
                                                                            commands: [
                                                                                Arithmetic(
                                                                                    "strip_tabs[slot] == 1",
                                                                                ),
                                                                            ],
                                                                        },
                                                                        body: CshAst {
                                                                            commands: [
                                                                                Loop {
                                                                                    until: false,
                                                                                    condition: CshAst {
                                                                                        commands: [
                                                                                            Test(
                                                                                                " $candidate_delim == $'\\t'* ",
                                                                                            ),
                                                                                        ],
                                                                                    },
                                                                                    body: CshAst {
                                                                                        commands: [
                                                                                            Command(
                                                                                                CshAstCommand {
                                                                                                    assignments: [
                                                                                                        CshAstAssignment {
                                                                                                            name: "candidate_delim",
                                                                                                            value: "${candidate_delim#$'\\t'}",
                                                                                                        },
                                                                                                    ],
                                                                                                    name: "",
                                                                                                    args: [],
                                                                                                },
                                                                                            ),
                                                                                        ],
                                                                                    },
                                                                                },
                                                                            ],
                                                                        },
                                                                    },
                                                                ],
                                                                otherwise: None,
                                                            },
                                                            If {
                                                                branches: [
                                                                    CshAstBranch {
                                                                        condition: CshAst {
                                                                            commands: [
                                                                                Test(
                                                                                    " $candidate_delim == \"$delim\" ",
                                                                                ),
                                                                            ],
                                                                        },
                                                                        body: CshAst {
                                                                            commands: [
                                                                                Command(
                                                                                    CshAstCommand {
                                                                                        assignments: [
                                                                                            CshAstAssignment {
                                                                                                name: "terminated",
                                                                                                value: "0",
                                                                                            },
                                                                                        ],
                                                                                        name: "",
                                                                                        args: [],
                                                                                    },
                                                                                ),
                                                                                Command(
                                                                                    CshAstCommand {
                                                                                        assignments: [],
                                                                                        name: "break",
                                                                                        args: [],
                                                                                    },
                                                                                ),
                                                                            ],
                                                                        },
                                                                    },
                                                                ],
                                                                otherwise: None,
                                                            },
                                                            Command(
                                                                CshAstCommand {
