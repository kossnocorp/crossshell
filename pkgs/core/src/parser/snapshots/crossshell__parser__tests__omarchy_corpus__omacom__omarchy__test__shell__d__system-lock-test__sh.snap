---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/system-lock-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "tmpdir",
                        value: "$(mktemp -d)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "trap",
                args: [
                    "rm -rf \"$tmpdir\"",
                    "EXIT",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "mock_bin",
                        value: "$tmpdir/bin",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "call_log",
                        value: "$tmpdir/calls",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "$mock_bin",
                ],
            },
        ),
        For {
            variable: "command",
            words: Some(
                [
                    "omarchy-shell",
                    "hyprctl",
                    "pkill",
                    "timeout",
                ],
            ),
            body: CshAst {
                commands: [
                    Redirected {
                        expression: Command(
                            CshAstCommand {
                                assignments: [],
                                name: "cat",
                                args: [],
                            },
                        ),
                        redirects: [
                            CshAstRedirect {
                                descriptor: None,
                                operator: ">",
                                target: "$mock_bin/$command",
                            },
                            CshAstRedirect {
                                descriptor: None,
                                operator: "<<",
                                target: "SH",
                                here_document: 0,
                            },
                        ],
                    },
                ],
            },
        },
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$mock_bin/pgrep",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "SH",
                    here_document: 1,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "chmod",
                args: [
                    "+x",
                    "$mock_bin/*",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "PATH",
                        value: "$mock_bin:$PATH",
                    },
                    CshAstAssignment {
                        name: "CALL_LOG",
                        value: "$call_log",
                    },
                ],
                name: "$ROOT/bin/omarchy-system-lock",
                args: [],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "mapfile",
                    args: [
                        "-t",
                        "shutdown",
                    ],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: "<",
                    target: "<(rg '^(pkill|timeout) ' \"$call_log\")",
                },
            ],
        },
        Binary {
            left: Test(
                " ${shutdown[0]} == \"pkill -x ttfx\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "system lock stops ttfx before closing its terminal",
                        "calls: ${shutdown[*]}",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " ${shutdown[1]} == \"timeout 1s pidwait -x ttfx\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "system lock waits for ttfx to exit",
                        "calls: ${shutdown[*]}",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " ${shutdown[2]} == \"pkill -f [o]rg.omarchy.screensaver\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "system lock closes the screensaver terminal after ttfx exits",
                        "calls: ${shutdown[*]}",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "system lock waits for ttfx before closing its terminal",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "SH",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nprintf '%s %s\\n' \"$(basename \"$0\")\" \"$*\" >>\"$CALL_LOG\"\n",
        },
        CshAstHereDocument {
            delimiter: "SH",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nexit 1\n",
        },
    ],
}
