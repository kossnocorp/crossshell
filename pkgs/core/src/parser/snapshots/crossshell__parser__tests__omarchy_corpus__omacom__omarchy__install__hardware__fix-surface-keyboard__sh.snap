---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/hardware/fix-surface-keyboard.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-hw-surface",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "product_name",
                                            value: "$(cat /sys/class/dmi/id/product_name 2>/dev/null)",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "echo",
                                    args: [
                                        "Detected Surface Device",
                                    ],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " $product_name != \"Surface Laptop 3\" ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "Untested Surface Device: $product_name, additional modules may be required for your device.",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "echo",
                                    args: [
                                        "Attempting to autodetect required pinctrl module",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "pinctrl_module",
                                            value: "$(lsmod | grep pinctrl_ | cut -f 1 -d\" \" || true)",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " -z $pinctrl_module ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "Failed to autodetect pinctrl module.",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: Some(
                                    CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "echo",
                                                    args: [
                                                        "Detected pinctrl module: $pinctrl_module",
                                                    ],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "mkdir",
                                                    args: [
                                                        "-p",
                                                        "/etc/mkinitcpio.conf.d",
                                                    ],
                                                },
                                            ),
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "MODULES=(${pinctrl_module} surface_aggregator surface_aggregator_registry surface_aggregator_hub surface_hid_core surface_hid surface_kbd intel_lpss_pci 8250_dw)",
                                                        ],
                                                    },
                                                ),
                                                redirects: [
                                                    CshAstRedirect {
                                                        descriptor: None,
                                                        operator: ">",
                                                        target: "/etc/mkinitcpio.conf.d/surface_device_modules.conf",
                                                    },
                                                ],
                                            },
                                        ],
                                    },
                                ),
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
