            body: "#!/bin/bash\n\nif [[ ${1:-} == \"hyprsunset\" && ${2:-} == \"temperature\" ]]; then\n  if [[ -n ${3:-} ]]; then\n    printf '%s\\n' \"$3\" >\"$HYPRSUNSET_STATE\"\n  else\n    cat \"$HYPRSUNSET_STATE\" 2>/dev/null || exit 1\n  fi\n  exit 0\nfi\n\nexit 1\n",
