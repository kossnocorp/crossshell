---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/config/fix-powerprofilesctl-shebang.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                Unary {
                                    operator: Regular,
                                    operand: Literal(
                                        "/usr/bin/powerprofilesctl",
                                    ),
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: Some(
                                        Literal(
                                            "sudo",
                                        ),
                                    ),
                                    args: [
                                        Literal(
                                            "sed",
                                        ),
                                        Literal(
                                            "-i",
                                        ),
                                        SingleQuoted(
                                            "/env python3/ c\\#!/bin/python3",
                                        ),
                                        Literal(
                                            "/usr/bin/powerprofilesctl",
                                        ),
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
