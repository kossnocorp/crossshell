---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/config/fix-powerprofilesctl-shebang.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -f /usr/bin/powerprofilesctl ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "sed",
                                        "-i",
                                        "/env python3/ c\\#!/bin/python3",
                                        "/usr/bin/powerprofilesctl",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
