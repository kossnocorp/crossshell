---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/user/hardware/asus/fix-audio-mixer.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-hw-asus-rog",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "mkdir",
                                    args: [
                                        "-p",
                                        "~/.config/wireplumber/wireplumber.conf.d/",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "cp",
                                    args: [
                                        "$OMARCHY_PATH/default/wireplumber/wireplumber.conf.d/alsa-soft-mixer.conf",
                                        "~/.config/wireplumber/wireplumber.conf.d/",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "rm",
                                    args: [
                                        "-rf",
                                        "~/.local/state/wireplumber/default-routes",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "card",
                                            value: "$(aplay -l 2>/dev/null | grep -i \"ALC285\" | head -1 | sed 's/card \\([0-9]*\\).*/\\1/')",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " -n $card ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Redirected {
                                                    expression: Command(
                                                        CshAstCommand {
                                                            assignments: [],
                                                            name: "amixer",
                                                            args: [
                                                                "-c",
                                                                "$card",
                                                                "set",
                                                                "Master",
                                                                "80%",
                                                                "unmute",
                                                            ],
                                                        },
                                                    ),
                                                    redirects: [
                                                        CshAstRedirect {
                                                            descriptor: Some(
                                                                "2",
                                                            ),
                                                            operator: ">",
                                                            target: "/dev/null",
                                                        },
                                                    ],
                                                },
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
