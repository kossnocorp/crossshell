---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/locale-env-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(dirname \"$0\")/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "envs",
                        value: "$ROOT/default/bash/envs",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "lang",
                        value: "$(env -u LANG bash -c 'source \"$1\"; printf \"%s\" \"$LANG\"' bash \"$envs\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " -n $lang ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bash env sets a locale when none is inherited",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bash env sets a locale when none is inherited",
                ],
            },
        ),
        Binary {
            left: Test(
                " ${lang,,} == *utf-8 || ${lang,,} == *utf8 ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bash env picks a UTF-8 locale",
                        "actual: $lang",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bash env picks a UTF-8 locale",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "lang",
                        value: "$(LANG=en_DK.UTF-8 bash -c 'source \"$1\"; printf \"%s\" \"$LANG\"' bash \"$envs\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $lang == \"en_DK.UTF-8\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bash env preserves the inherited locale",
                        "actual: $lang",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bash env preserves the inherited locale",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "glyph",
                        value: "$(env -u LANG bash -c 'source \"$1\"; printf \"\\U000F17A9\"' bash \"$envs\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $glyph != *'\\U'* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bash env locale renders unicode escapes",
                        "actual: $glyph",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bash env locale renders unicode escapes",
                ],
            },
        ),
    ],
}
