---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/hardware/intel/lpmd.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Binary {
                                left: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "omarchy-hw-intel",
                                        args: [],
                                    },
                                ),
                                operator: And,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "omarchy-battery-present",
                                        args: [],
                                    },
                                ),
                            },
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "cpu_model",
                                            value: "$(grep -m1 \"^model\\s*:\" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | tr -d ' ')",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " \"$cpu_model\" =~ ^(151|154|170|172|183|186|189|191|204)$ ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "omarchy-pkg-add",
                                                        args: [
                                                            "intel-lpmd",
                                                        ],
                                                    },
                                                ),
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "sudo",
                                                        args: [
                                                            "systemctl",
                                                            "enable",
                                                            "intel_lpmd.service",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
