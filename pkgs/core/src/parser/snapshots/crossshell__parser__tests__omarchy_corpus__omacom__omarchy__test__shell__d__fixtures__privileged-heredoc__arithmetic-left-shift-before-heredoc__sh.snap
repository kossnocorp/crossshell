---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/fixtures/privileged-heredoc/arithmetic-left-shift-before-heredoc.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "mask",
                        value: "$((1 << bits))",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "/etc/omarchy/agent.conf",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
                    here_document: 0,
                },
            ],
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            body: "helper=$HOME/.local/share/omarchy/bin/omarchy-agent\n",
        },
    ],
}
