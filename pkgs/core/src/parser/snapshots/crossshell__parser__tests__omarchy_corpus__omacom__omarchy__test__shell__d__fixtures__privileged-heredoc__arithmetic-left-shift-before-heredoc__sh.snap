---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "mask",
                        operator: Set,
                        value: ArithmeticExpansion(
                            Binary {
                                left: Number {
                                    radix: 10,
                                    digits: "1",
                                },
                                operator: ShiftLeft,
                                right: Variable(
                                    "bits",
                                ),
                            },
                        ),
                    },
                ],
                name: None,
                args: [],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: Some(
                        Literal(
                            "cat",
                        ),
                    ),
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: Default,
                    operator: Output,
                    target: Literal(
                        "/etc/omarchy/agent.conf",
                    ),
                },
                CshAstRedirect {
                    descriptor: Default,
                    operator: HereDocument,
                    target: Literal(
                        "EOF",
                    ),
                    here_document: 0,
                },
            ],
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            content: Concat(
                [
                    Literal(
                        "helper=",
