                    Binary {
                        left: Redirected {
                            expression: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "grep",
                                    args: [
                                        "-F",
                                        "sudo /usr/bin/mv -Tf -- \"$stage\" \"$destination\"",
                                        "$ROOT/$script",
                                    ],
                                },
