                                            redirects: [
                                                CshAstRedirect {
                                                    descriptor: None,
                                                    operator: ">",
                                                    target: "/dev/null",
                                                },
                                            ],
                                        },
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
