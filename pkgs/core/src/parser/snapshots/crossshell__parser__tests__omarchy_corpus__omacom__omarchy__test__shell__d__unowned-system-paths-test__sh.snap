                            CshAstCommand {
                                assignments: [],
                                name: "fail",
                                args: [
                                    "$script atomically replaces the privileged destination",
                                ],
                            },
                        ),
                    },
                    If {
                        branches: [
                            CshAstBranch {
                                condition: CshAst {
                                    commands: [
                                        Redirected {
                                            expression: Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "grep",
                                                    args: [
                                                        "-F",
                                                        "sudo /usr/bin/chmod \"$mode\" \"$destination\"",
                                                        "$ROOT/$script",
                                                    ],
