---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/panel-command-path-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "matches",
                                            value: "$(rg -n 'root\\.bar\\.omarchyPath|/bin/omarchy-' \"$ROOT/shell/plugins/panels\" -g '*.qml')",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "panels do not resolve omarchy helpers through bar paths",
                                        "$matches",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "panels avoid bar path resolution for omarchy helpers",
                ],
            },
        ),
    ],
}
