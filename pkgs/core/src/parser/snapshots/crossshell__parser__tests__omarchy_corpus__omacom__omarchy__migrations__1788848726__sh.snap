---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/migrations/1788848726.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Retire the stock user icon font missed by the Quattro upgrade",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "legacy_font",
                        value: "$HOME/.local/share/fonts/omarchy.ttf",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -f $legacy_font && ! -L $legacy_font ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "legacy_hash",
                                            value: "$(sha256sum \"$legacy_font\")",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " ${legacy_hash%% *} == \"e55e67119e82f56f92d90cbf54b7ccc1b2946b32c535a29370439d7ef5215966\" ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                If {
                                                    branches: [
                                                        CshAstBranch {
                                                            condition: CshAst {
                                                                commands: [
                                                                    Test(
                                                                        " ! -f /usr/share/fonts/omarchy/omarchy.ttf ",
                                                                    ),
                                                                ],
                                                            },
                                                            body: CshAst {
                                                                commands: [
                                                                    Redirected {
                                                                        expression: Command(
                                                                            CshAstCommand {
                                                                                assignments: [],
                                                                                name: "echo",
                                                                                args: [
                                                                                    "Packaged Omarchy icon font is missing; keeping the legacy font.",
                                                                                ],
                                                                            },
                                                                        ),
                                                                        redirects: [
                                                                            CshAstRedirect {
                                                                                descriptor: None,
                                                                                operator: ">&",
                                                                                target: "2",
                                                                            },
                                                                        ],
                                                                    },
                                                                    Command(
                                                                        CshAstCommand {
                                                                            assignments: [],
                                                                            name: "exit",
                                                                            args: [
                                                                                "1",
                                                                            ],
                                                                        },
                                                                    ),
                                                                ],
                                                            },
                                                        },
                                                    ],
                                                    otherwise: None,
                                                },
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "rm",
                                                        args: [
                                                            "$legacy_font",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "fc-cache",
                args: [
                    "-f",
                ],
            },
        ),
    ],
}
