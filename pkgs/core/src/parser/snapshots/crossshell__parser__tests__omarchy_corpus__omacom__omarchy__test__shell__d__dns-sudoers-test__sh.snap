        CshAstHereDocument {
            delimiter: "SH",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nif [[ $1 == -n && $2 == -l ]]; then\n  for granted in ${STUB_GRANTED-Cloudflare Google DHCP}; do\n    [[ ${!#} == \"$granted\" ]] || continue\n    echo \"    Options: !authenticate\"\n    exit 0\n  done\n  echo \"    Matched: ${!#}\"\n  exit 0\nfi\nprintf 'sudo %s\\n' \"$*\" >\"$ELEVATION_LOG\"\n",
        },
