                        name: "no_key",
                        value: "$(HOME=\"$TEST_HOME\" XDG_CONFIG_HOME=\"$TEST_HOME/.config\" XDG_DATA_HOME=\"$TEST_HOME/.local/share\" \\\n  FIREWORKS_API_KEY=\"\" FIREWORKS_AUTH_PATH=\"$TEST_HOME/missing.ini\" \"$ROOT/bin/omarchy-agent-usage-fireworks\")",
