---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/bin-style-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "raw_command_checks",
                        value: "$(rg -l 'command -v' \"$ROOT/bin\" \\\n  | rg -v '/omarchy-(cmd-|pkg-|upgrade-to-quattro)' || true)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " -z $raw_command_checks ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bin commands use command helpers",
                        "$raw_command_checks",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bin commands use command helpers",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "raw_notifications",
                        value: "$(rg -l -P '^[[:space:]]*[^#[:space:]].*\\bnotify-send\\b' \"$ROOT/bin\" || true)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " -z $raw_notifications ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bin commands use the notification helper, never notify-send",
                        "$raw_notifications",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bin commands use the notification helper",
                ],
            },
        ),
    ],
}
