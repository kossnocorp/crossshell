                                        descriptor: None,
                                        operator: ">",
                                        target: "/etc/modprobe.d/blacklist-clevo-xsm-wmi.conf",
                                    },
                                ],
                            },
                            For {
                                variable: "f",
                                words: Some(
                                    [
                                        "/lib/modules/*/extra/clevo-xsm-wmi.ko",
