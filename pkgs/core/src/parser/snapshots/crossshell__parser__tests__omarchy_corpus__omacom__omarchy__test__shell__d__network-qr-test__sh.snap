                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "network QR helper rejects enterprise networks",
                                        "helper unexpectedly succeeded",
                                    ],
                                },
