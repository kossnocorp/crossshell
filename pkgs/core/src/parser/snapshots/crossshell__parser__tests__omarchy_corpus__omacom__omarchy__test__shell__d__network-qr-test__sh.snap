                    "WIFI:T:WPA;S:Cafe Detected;P:secret;;",
                    "--meta",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_success_case",
                args: [
                    "network QR helper supports open networks",
                    "$Cafe Open\\nnone\\n\\nno\\n",
                    "WIFI:T:nopass;S:Cafe Open;P:;;",
                    "--meta",
                    "wlan0",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_success_case",
                args: [
                    "network QR helper marks hidden networks",
                    "$Hidden Network\\nwpa-psk\\nsecret\\nyes\\n",
                    "WIFI:T:WPA;S:Hidden Network;P:secret;H:true;;",
                    "--meta",
                    "wlan0",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_success_case",
                args: [
                    "network QR helper encodes WEP networks",
                    "$Old Router\\nnone\\n\\nno\\nwep-secret\\n",
                    "WIFI:T:WEP;S:Old Router;P:wep-secret;;",
                    "--meta",
                    "wlan0",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "QR_NMCLI_FIELDS=$Enterprise\\nwpa-eap\\nsecret\\nno\\n",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "QR_PAYLOAD_FILE=$tmp/enterprise-payload",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [
                                            CshAstAssignment {
                                                name: "PATH",
                                                value: "$tmp/bin:$PATH",
                                            },
                                        ],
                                        name: "$ROOT/bin/omarchy-network-qr",
                                        args: [
                                            "wlan0",
                                        ],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: ">",
                                        target: "$tmp/enterprise-output",
                                    },
                                    CshAstRedirect {
                                        descriptor: Some(
