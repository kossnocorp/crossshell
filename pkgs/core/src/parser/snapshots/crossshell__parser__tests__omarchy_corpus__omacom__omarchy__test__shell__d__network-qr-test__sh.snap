                                assignments: [
                                    CshAstAssignment {
                                        name: "payload",
                                        value: "$(<\"$QR_PAYLOAD_FILE\")",
                                    },
                                ],
                                name: "",
                                args: [],
                            },
                        ),
                        Binary {
                            left: Test(
                                " $payload == \"$expected_payload\" ",
                            ),
                            operator: Or,
                            right: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "$description generates the Wi-Fi payload",
                                        "expected: $expected_payload\\nactual: $payload",
                                    ],
                                },
                            ),
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "$description",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_success_case",
                args: [
                    "network QR helper escapes WPA credentials through stdin",
