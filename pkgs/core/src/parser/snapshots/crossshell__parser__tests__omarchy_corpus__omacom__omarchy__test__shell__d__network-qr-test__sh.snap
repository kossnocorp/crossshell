        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "enterprise_error",
                        value: "$(<\"$tmp/enterprise-error\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "expected_error",
                        value: "Enterprise Wi-Fi cannot be shared with a password QR code",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $enterprise_error == \"$expected_error\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "network QR helper rejects enterprise networks",
                        "expected: $expected_error\\nactual: $enterprise_error",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " ! -e $QR_PAYLOAD_FILE ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "network QR helper rejects enterprise networks",
                        "qrencode unexpectedly ran",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "network QR helper rejects enterprise networks",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nif [[ $* == *\"DEVICE,TYPE,STATE\"* ]]; then\n  printf 'eth0:ethernet:connected\\nwlan0:wifi:connected\\n'\nelif [[ $* == *GENERAL.CON-UUID* ]]; then\n  echo test-uuid\nelse\n  printf '%s' \"$QR_NMCLI_FIELDS\"\nfi\n",
        },
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nfor arg in \"$@\"; do\n  [[ $arg != WIFI:* ]] || exit 97\ndone\npayload=$(</dev/stdin)\nprintf '%s' \"$payload\" >\"$QR_PAYLOAD_FILE\"\nprintf '##    \\n  ##  \\n    ##\\n'\n",
        },
    ],
}
