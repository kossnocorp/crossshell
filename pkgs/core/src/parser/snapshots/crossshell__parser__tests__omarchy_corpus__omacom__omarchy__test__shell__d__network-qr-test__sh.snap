                    descriptor: None,
                    operator: ">",
                    target: "$tmp/bin/qrencode",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
                    here_document: 1,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "chmod",
                args: [
                    "+x",
                    "$tmp/bin/nmcli",
                    "$tmp/bin/qrencode",
                ],
            },
        ),
        Function {
            name: "run_success_case",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "description=$1",
                                    "fields=$2",
                                    "expected_payload=$3",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "shift",
                                args: [
                                    "3",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "output",
                                    "meta",
                                    "matrix",
                                    "payload",
                                    "arg",
                                    "with_meta=false",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "expected_matrix",
                                    "expected_security",
                                    "expected_ssid",
                                    "expected_iface=*",
                                ],
                            },
                        ),
                        For {
                            variable: "arg",
                            words: Some(
                                [
                                    "$@",
                                ],
