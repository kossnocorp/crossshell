                                    body: CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "meta",
                                                            value: "$(head -n1 <<<\"$output\")",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "matrix",
                                                            value: "$(tail -n +2 <<<\"$output\")",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "expected_security",
                                                            value: "${expected_payload#WIFI:T:}",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "expected_security",
                                                            value: "${expected_security%%;*}",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "expected_ssid",
                                                            value: "$(head -n1 <<<\"$fields\")",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Binary {
                                                left: Test(
                                                    " $meta == meta$'\\t'$expected_iface$'\\t'\"$expected_security\"$'\\t'\"$expected_ssid\" ",
                                                ),
                                                operator: Or,
                                                right: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "fail",
                                                        args: [
                                                            "$description leads with the interface, security, and SSID",
                                                            "actual: $meta",
                                                        ],
                                                    },
                                                ),
                                            },
                                        ],
                                    },
                                },
                            ],
                            otherwise: Some(
                                CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [
                                                    CshAstAssignment {
                                                        name: "matrix",
                                                        value: "$output",
                                                    },
                                                ],
                                                name: "",
                                                args: [],
                                            },
                                        ),
                                    ],
                                },
                            ),
                        },
                        Binary {
                            left: Test(
