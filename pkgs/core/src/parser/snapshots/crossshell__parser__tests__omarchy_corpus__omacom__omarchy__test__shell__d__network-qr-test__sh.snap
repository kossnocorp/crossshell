                    "WIFI:T:WPA;S:Cafe\\;Guest\\\\5G;P:p\\,a\\:ss\\;word\\\\42;;",
                    "--meta",
                    "wlan0",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_success_case",
                args: [
                    "network QR helper keeps the bare matrix without --meta",
                    "$Cafe;Guest\\\\5G\\nwpa-psk\\np,a:ss;word\\\\42\\nno\\n",
                    "WIFI:T:WPA;S:Cafe\\;Guest\\\\5G;P:p\\,a\\:ss\\;word\\\\42;;",
