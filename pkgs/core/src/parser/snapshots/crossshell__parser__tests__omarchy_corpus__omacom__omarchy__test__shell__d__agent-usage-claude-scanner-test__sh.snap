        CshAstHereDocument {
            delimiter: "EOF",
            quoted: false,
            strip_tabs: false,
            body: "{\"timestamp\":86400000,\"sessionId\":\"old\",\"display\":\"ancient\"}\n{\"timestamp\":$now_ms,\"sessionId\":\"s1\",\"display\":\"one\"}\n{\"timestamp\":$now_ms,\"sessionId\":\"s2\",\"display\":\"two\"}\n",
