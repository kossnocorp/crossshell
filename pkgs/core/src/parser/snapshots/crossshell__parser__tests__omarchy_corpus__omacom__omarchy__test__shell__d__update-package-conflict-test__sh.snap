    here_documents: [
        CshAstHereDocument {
            delimiter: "STUB",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nexec \"$@\"\n",
        },
        CshAstHereDocument {
            delimiter: "STUB",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nwhile [[ $1 == -* ]]; do shift; done\nexec \"$@\"\n",
        },
        CshAstHereDocument {
            delimiter: "STUB",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nattempt=$(($(cat \"$PACMAN_ATTEMPTS\") + 1))\necho \"$attempt\" >\"$PACMAN_ATTEMPTS\"\n{\n  printf 'args %s\\n' \"$*\"\n  for fd in 0 1 2; do\n    if [[ -t $fd ]]; then printf 'tty%s yes\\n' \"$fd\"; else printf 'tty%s no\\n' \"$fd\"; fi\n  done\n} >>\"$PACMAN_CALLS\"\n\nif ((attempt == 1)); then\n  cat \"$CONFLICT_REPORT\" >&2\n  exit 1\nfi\necho \"upgrade complete\"\n",
        },
    ],
