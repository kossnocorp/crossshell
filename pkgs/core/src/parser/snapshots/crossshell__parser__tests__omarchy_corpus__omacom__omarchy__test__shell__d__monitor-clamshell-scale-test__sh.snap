        CshAstHereDocument {
            delimiter: "LUA",
            quoted: true,
            strip_tabs: false,
            body: "local omarchy_gdk_scale = 2\nlocal omarchy_monitor_scale = \"auto\"\n",
        },
        CshAstHereDocument {
            delimiter: "LUA",
            quoted: true,
            strip_tabs: false,
            body: "local omarchy_gdk_scale = 2\nlocal omarchy_monitor_scale = \"auto\"\n\nhl.env(\"GDK_SCALE\", tostring(omarchy_gdk_scale))\nhl.monitor({ output = \"\", mode = \"preferred\", position = \"auto\", scale = omarchy_monitor_scale })\n",
        },
