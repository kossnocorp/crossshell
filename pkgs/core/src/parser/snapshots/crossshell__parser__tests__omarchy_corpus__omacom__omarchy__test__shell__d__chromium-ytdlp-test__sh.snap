            body: "source \"$1\"\nfilepath=\"\"\nwhile IFS= read -r line; do\n  case $line in\n  OMARCHY_FILE*)\n    resolved=$(resolve_download_file \"${line#OMARCHY_FILE$'\\t'}\") || continue\n    filepath=$resolved\n    ;;\n  esac\ndone\nprintf '%s' \"$filepath\"\n",
