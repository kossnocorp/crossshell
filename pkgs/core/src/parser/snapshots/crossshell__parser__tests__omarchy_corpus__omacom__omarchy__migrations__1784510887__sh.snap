expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Switch Brave Origin from the beta to the stable release",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-pkg-present",
                                    args: [
                                        "brave-origin-beta-bin",
                                    ],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "default_browser",
                                            value: "$(xdg-settings get default-web-browser 2>/dev/null || true)",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-pkg-aur-add",
                                    args: [
                                        "brave-origin-bin",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-pkg-drop",
                                    args: [
                                        "brave-origin-beta-bin",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "mkdir",
                                    args: [
                                        "-p",
                                        "~/.config",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "cp",
                                    args: [
                                        "-f",
                                        "$OMARCHY_PATH/config/chromium-flags.conf",
                                        "~/.config/brave-origin-flags.conf",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "rm",
                                    args: [
                                        "-f",
                                        "~/.config/brave-origin-beta-flags.conf",
                                    ],
                                },
                            ),
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " $default_browser == \"brave-origin-beta.desktop\" ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "omarchy-default-browser",
                                                        args: [
                                                            "brave-origin",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                        ],
                    },
                },
