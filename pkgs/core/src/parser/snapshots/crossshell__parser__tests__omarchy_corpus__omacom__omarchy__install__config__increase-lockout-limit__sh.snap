---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/config/increase-lockout-limit.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "sed",
                args: [
                    "-i",
                    "s|^\\(auth\\s\\+required\\s\\+pam_faillock.so\\)\\s\\+preauth.*$|\\1 preauth silent deny=10 unlock_time=120|",
                    "/etc/pam.d/system-auth",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sed",
                args: [
                    "-i",
                    "s|^\\(auth\\s\\+\\[default=die\\]\\s\\+pam_faillock.so\\)\\s\\+authfail.*$|\\1 authfail deny=10 unlock_time=120|",
                    "/etc/pam.d/system-auth",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sed",
                args: [
                    "-i",
                    "/pam_faillock\\.so preauth/d",
                    "/etc/pam.d/sddm-autologin",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sed",
                args: [
                    "-i",
                    "/pam_faillock\\.so authsucc/d",
                    "/etc/pam.d/sddm-autologin",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sed",
                args: [
                    "-i",
                    "/auth.*pam_permit\\.so/a auth        required    pam_faillock.so authsucc",
                    "/etc/pam.d/sddm-autologin",
                ],
            },
        ),
    ],
}
