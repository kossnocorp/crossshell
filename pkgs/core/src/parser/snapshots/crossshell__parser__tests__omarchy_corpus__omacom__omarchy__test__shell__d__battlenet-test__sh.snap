---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/battlenet-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "install_script",
                        value: "$ROOT/bin/omarchy-install-gaming-battlenet",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " ! -f $ROOT/applications/battlenet.desktop ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "Battle.net launcher is not part of default application refresh",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " -f $ROOT/default/applications/battlenet.desktop ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "Battle.net launcher template is available to the installer",
                    ],
                },
            ),
        },
        Binary {
            left: Redirected {
                expression: Command(
                    CshAstCommand {
                        assignments: [],
                        name: "grep",
                        args: [
                            "-F",
                            "$OMARCHY_PATH/default/applications/battlenet.desktop",
                            "$install_script",
                        ],
                    },
                ),
                redirects: [
                    CshAstRedirect {
                        descriptor: None,
                        operator: ">",
                        target: "/dev/null",
                    },
                ],
            },
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "Battle.net installer installs the launcher from the installer-only template",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "Battle.net launcher is only installed by the Battle.net installer",
                ],
            },
        ),
    ],
}
