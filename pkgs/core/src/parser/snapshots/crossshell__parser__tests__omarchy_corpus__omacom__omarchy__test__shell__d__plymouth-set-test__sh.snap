            body: "#!/bin/bash\nmode=\nwhile (( $# )); do\n  case \"$1\" in\n  -o | -g)\n    shift 2\n    ;;\n  -m)\n    mode=$2\n    shift 2\n    ;;\n  --)\n    shift\n    break\n    ;;\n  *)\n    exit 96\n    ;;\n  esac\ndone\n\n(( $# == 2 )) || exit 96\n[[ $mode == \"0600\" || $mode == \"0644\" ]] || exit 96\ndestination=$2\n[[ $destination == \"$TEST_FAKE_ROOT\"* || $destination == /tmp/omarchy-plymouth.* ]] || exit 93\nexec /usr/bin/install -m \"$mode\" -- \"$1\" \"$destination\"\n",
        },
