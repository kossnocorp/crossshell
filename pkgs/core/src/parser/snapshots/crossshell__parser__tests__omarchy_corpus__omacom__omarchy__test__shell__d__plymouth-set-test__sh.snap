                                },
                                Binary {
                                    left: Test(
                                        " $(stat -c %a \"$destination\") == 644 ",
                                    ),
                                    operator: Or,
                                    right: Command(
                                        CshAstCommand {
                                            assignments: [],
                                            name: "fail",
                                            args: [
                                                "Plymouth $asset is mode 0644 under umask $requested_umask",
                                            ],
