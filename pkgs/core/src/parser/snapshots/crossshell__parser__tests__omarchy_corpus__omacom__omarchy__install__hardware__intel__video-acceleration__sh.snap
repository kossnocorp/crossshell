---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/hardware/intel/video-acceleration.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [
                                        CshAstAssignment {
                                            name: "INTEL_GPU",
                                            value: "$(lspci | grep -iE 'vga|3d|display' | grep -i 'intel')",
                                        },
                                    ],
                                    name: "",
                                    args: [],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            If {
                                branches: [
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " ${INTEL_GPU,,} =~ (hd\\ graphics|uhd\\ graphics|xe|iris|arc|panther\\ lake) ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "omarchy-pkg-add",
                                                        args: [
                                                            "intel-media-driver",
                                                            "libvpl",
                                                            "vpl-gpu-rt",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                    CshAstBranch {
                                        condition: CshAst {
                                            commands: [
                                                Test(
                                                    " ${INTEL_GPU,,} =~ \"gma\" ",
                                                ),
                                            ],
                                        },
                                        body: CshAst {
                                            commands: [
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "omarchy-pkg-add",
                                                        args: [
                                                            "libva-intel-driver",
                                                        ],
                                                    },
                                                ),
                                            ],
                                        },
                                    },
                                ],
                                otherwise: None,
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
