                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "suffix",
                                                            value: "/.local/share/omarchy/bin/omarchy-wifi-powersave on\"",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            If {
                                                branches: [
                                                    CshAstBranch {
                                                        condition: CshAst {
                                                            commands: [
                                                                Test(
                                                                    " ${lines[0]} == \"$prefix\"*\"$suffix\" ",
                                                                ),
                                                            ],
                                                        },
                                                        body: CshAst {
                                                            commands: [
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [
                                                                            CshAstAssignment {
                                                                                name: "home",
                                                                                value: "${lines[0]#\"$prefix\"}",
                                                                            },
                                                                        ],
                                                                        name: "",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [
                                                                            CshAstAssignment {
                                                                                name: "home",
                                                                                value: "${home%\"$suffix\"}",
                                                                            },
                                                                        ],
                                                                        name: "",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [
                                                                            CshAstAssignment {
                                                                                name: "expected",
                                                                                value: "SUBSYSTEM==\"power_supply\", ATTR{type}==\"Mains\", ATTR{online}==\"1\", RUN+=\"$home/.local/share/omarchy/bin/omarchy-wifi-powersave off\"",
                                                                            },
                                                                        ],
                                                                        name: "",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Binary {
                                                                    left: Test(
                                                                        " $home == /* && $home != *'\"'* && ${lines[1]} == \"$expected\" ",
                                                                    ),
                                                                    operator: And,
                                                                    right: Command(
                                                                        CshAstCommand {
                                                                            assignments: [],
                                                                            name: "return",
                                                                            args: [
                                                                                "0",
                                                                            ],
                                                                        },
                                                                    ),
                                                                },
                                                            ],
                                                        },
                                                    },
                                                ],
                                                otherwise: None,
                                            },
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "prefix",
                                                            value: "SUBSYSTEM==\"power_supply\", ATTR{type}==\"Mains\", ATTR{online}==\"0\", RUN+=\"/usr/bin/systemd-run --no-block --collect --unit=omarchy-wifi-powersave-on ",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            Command(
                                                CshAstCommand {
                                                    assignments: [
                                                        CshAstAssignment {
                                                            name: "suffix",
                                                            value: "/.local/share/omarchy/bin/omarchy-wifi-powersave on\"",
                                                        },
                                                    ],
                                                    name: "",
                                                    args: [],
                                                },
                                            ),
                                            If {
                                                branches: [
                                                    CshAstBranch {
                                                        condition: CshAst {
                                                            commands: [
                                                                Test(
                                                                    " ${lines[0]} == \"$prefix\"*\"$suffix\" ",
                                                                ),
                                                            ],
                                                        },
                                                        body: CshAst {
                                                            commands: [
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [
                                                                            CshAstAssignment {
                                                                                name: "home",
                                                                                value: "${lines[0]#\"$prefix\"}",
                                                                            },
                                                                        ],
                                                                        name: "",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [
                                                                            CshAstAssignment {
                                                                                name: "home",
                                                                                value: "${home%\"$suffix\"}",
                                                                            },
                                                                        ],
                                                                        name: "",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [
                                                                            CshAstAssignment {
                                                                                name: "expected",
                                                                                value: "SUBSYSTEM==\"power_supply\", ATTR{type}==\"Mains\", ATTR{online}==\"1\", RUN+=\"/usr/bin/systemd-run --no-block --collect --unit=omarchy-wifi-powersave-off $home/.local/share/omarchy/bin/omarchy-wifi-powersave off\"",
                                                                            },
                                                                        ],
                                                                        name: "",
                                                                        args: [],
                                                                    },
                                                                ),
                                                                Binary {
                                                                    left: Test(
                                                                        " $home == /* && $home != *'\"'* && ${lines[1]} == \"$expected\" ",
                                                                    ),
                                                                    operator: And,
                                                                    right: Command(
                                                                        CshAstCommand {
                                                                            assignments: [],
                                                                            name: "return",
                                                                            args: [
                                                                                "0",
                                                                            ],
                                                                        },
                                                                    ),
                                                                },
                                                            ],
                                                        },
                                                    },
                                                ],
                                                otherwise: None,
                                            },
                                        ],
                                    },
                                    terminator: ";;",
                                },
                            ],
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "return",
                                args: [
                                    "1",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        Function {
            name: "finish_pending_reload",
            body: Group(
                CshAst {
                    commands: [
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Binary {
                                                left: Test(
                                                    " -e $udev_control ",
                                                ),
                                                operator: And,
                                                right: Negated(
                                                    Redirected {
                                                        expression: Command(
                                                            CshAstCommand {
                                                                assignments: [],
                                                                name: "as_root",
                                                                args: [
                                                                    "$udevadm_command",
                                                                    "control",
                                                                    "--reload",
                                                                ],
                                                            },
                                                        ),
                                                        redirects: [
                                                            CshAstRedirect {
                                                                descriptor: Some(
                                                                    "2",
                                                                ),
                                                                operator: ">",
                                                                target: "/dev/null",
                                                            },
                                                        ],
                                                    },
                                                ),
                                            },
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "Could not reload udev after removing a vulnerable legacy rule. Ask an administrator to run omarchy-migrate.",
                                                        ],
                                                    },
                                                ),
                                                redirects: [
                                                    CshAstRedirect {
                                                        descriptor: None,
                                                        operator: ">&",
                                                        target: "2",
                                                    },
                                                ],
                                            },
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "exit",
                                                    args: [
                                                        "1",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Negated(
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "as_root",
                                                        args: [
                                                            "$rm_command",
                                                            "-f",
                                                            "$reload_needed_marker",
                                                        ],
                                                    },
                                                ),
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "Could not finish the legacy udev-rule repair. Ask an administrator to run omarchy-migrate.",
                                                        ],
                                                    },
                                                ),
                                                redirects: [
                                                    CshAstRedirect {
                                                        descriptor: None,
                                                        operator: ">&",
                                                        target: "2",
                                                    },
                                                ],
                                            },
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "exit",
                                                    args: [
                                                        "1",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                    ],
                },
            ),
        },
        Function {
            name: "quarantine_rule",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "rule_file=$1",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "backup=$rule_file.omarchy-disabled",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "suffix=0",
                                ],
                            },
                        ),
                        Loop {
                            until: false,
                            condition: CshAst {
                                commands: [
                                    Test(
                                        " -e $backup || -L $backup ",
                                    ),
                                ],
                            },
                            body: CshAst {
                                commands: [
                                    Arithmetic(
                                        "++suffix",
                                    ),
                                    Command(
                                        CshAstCommand {
                                            assignments: [
                                                CshAstAssignment {
                                                    name: "backup",
                                                    value: "$rule_file.omarchy-disabled.$suffix",
                                                },
                                            ],
                                            name: "",
                                            args: [],
                                        },
                                    ),
                                ],
                            },
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "mark_reload_needed",
                                args: [],
                            },
                        ),
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Negated(
                                                Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "as_root",
                                                        args: [
                                                            "$mv_command",
                                                            "--no-clobber",
                                                            "--",
                                                            "$rule_file",
                                                            "$backup",
                                                        ],
                                                    },
                                                ),
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "Administrator privileges are required to quarantine the vulnerable legacy udev rule. Ask an administrator to run omarchy-migrate.",
                                                        ],
                                                    },
                                                ),
                                                redirects: [
                                                    CshAstRedirect {
                                                        descriptor: None,
                                                        operator: ">&",
                                                        target: "2",
                                                    },
                                                ],
                                            },
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "exit",
                                                    args: [
                                                        "1",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Test(
                                                " -e $rule_file || -L $rule_file ",
                                            ),
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [],
                                                        name: "echo",
                                                        args: [
                                                            "Could not quarantine the vulnerable legacy udev rule at $rule_file. Ask an administrator to run omarchy-migrate.",
                                                        ],
                                                    },
                                                ),
                                                redirects: [
                                                    CshAstRedirect {
                                                        descriptor: None,
                                                        operator: ">&",
                                                        target: "2",
                                                    },
                                                ],
                                            },
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "exit",
                                                    args: [
                                                        "1",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "finish_pending_reload",
                                args: [],
                            },
                        ),
                        Redirected {
                            expression: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "echo",
                                    args: [
                                        "Quarantined the modified legacy rule as $backup so udev cannot execute it. Review the preserved file before restoring any safe custom actions.",
                                    ],
                                },
                            ),
                            redirects: [
                                CshAstRedirect {
                                    descriptor: None,
                                    operator: ">&",
                                    target: "2",
                                },
                            ],
                        },
                    ],
                },
            ),
        },
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " -d $rules_dir && ! -x $rules_dir ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "echo",
                                        args: [
                                            "Could not inspect legacy udev rules under $rules_dir. Ask an administrator to run omarchy-migrate.",
                                        ],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: ">&",
                                        target: "2",
                                    },
                                ],
                            },
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "exit",
                                    args: [
                                        "1",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
        For {
            variable: "legacy_rule",
            words: Some(
                [
                    "99-power-profile.rules:omarchy-powerprofiles-set",
                    "99-wifi-powersave.rules:omarchy-wifi-powersave",
                ],
            ),
            body: CshAst {
                commands: [
                    Command(
                        CshAstCommand {
                            assignments: [
                                CshAstAssignment {
                                    name: "rule_name",
                                    value: "${legacy_rule%%:*}",
                                },
                            ],
                            name: "",
                            args: [],
                        },
                    ),
                    Command(
                        CshAstCommand {
                            assignments: [
                                CshAstAssignment {
                                    name: "rule_file",
                                    value: "$rules_dir/$rule_name",
                                },
                            ],
                            name: "",
                            args: [],
                        },
                    ),
                    Command(
                        CshAstCommand {
                            assignments: [
                                CshAstAssignment {
                                    name: "binary",
                                    value: "${legacy_rule##*:}",
                                },
                            ],
                            name: "",
                            args: [],
                        },
                    ),
                    Command(
                        CshAstCommand {
                            assignments: [
                                CshAstAssignment {
                                    name: "reload_needed_marker",
                                    value: "$reload_marker_prefix-$rule_name",
                                },
                            ],
                            name: "",
                            args: [],
                        },
                    ),
                    If {
                        branches: [
                            CshAstBranch {
                                condition: CshAst {
                                    commands: [
                                        Test(
                                            " -e $reload_needed_marker && ! -e $rule_file && ! -L $rule_file ",
                                        ),
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "finish_pending_reload",
                                                args: [],
                                            },
                                        ),
                                    ],
                                },
                            },
                        ],
                        otherwise: None,
                    },
                    If {
                        branches: [
                            CshAstBranch {
                                condition: CshAst {
                                    commands: [
                                        Test(
                                            " -f $rule_file && ! -r $rule_file ",
                                        ),
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Redirected {
                                            expression: Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "echo",
                                                    args: [
                                                        "Could not inspect the legacy udev rule at $rule_file. Ask an administrator to run omarchy-migrate.",
                                                    ],
                                                },
                                            ),
                                            redirects: [
                                                CshAstRedirect {
                                                    descriptor: None,
                                                    operator: ">&",
                                                    target: "2",
                                                },
                                            ],
                                        },
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "exit",
                                                args: [
                                                    "1",
                                                ],
                                            },
                                        ),
                                    ],
                                },
                            },
                        ],
                        otherwise: None,
                    },
                    If {
                        branches: [
                            CshAstBranch {
                                condition: CshAst {
                                    commands: [
                                        Binary {
                                            left: Test(
                                                " -f $rule_file ",
                                            ),
                                            operator: And,
                                            right: Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "rule_is_exact_generated",
                                                    args: [
                                                        "$rule_file",
                                                        "$binary",
                                                    ],
                                                },
                                            ),
                                        },
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "mark_reload_needed",
                                                args: [],
                                            },
                                        ),
                                        If {
                                            branches: [
                                                CshAstBranch {
                                                    condition: CshAst {
                                                        commands: [
                                                            Negated(
                                                                Command(
                                                                    CshAstCommand {
                                                                        assignments: [],
                                                                        name: "as_root",
                                                                        args: [
                                                                            "$rm_command",
                                                                            "-f",
                                                                            "$rule_file",
                                                                        ],
                                                                    },
                                                                ),
                                                            ),
                                                        ],
                                                    },
                                                    body: CshAst {
                                                        commands: [
                                                            Redirected {
                                                                expression: Command(
                                                                    CshAstCommand {
                                                                        assignments: [],
                                                                        name: "echo",
                                                                        args: [
                                                                            "Administrator privileges are required to remove the vulnerable legacy udev rule. Ask an administrator to run omarchy-migrate.",
                                                                        ],
                                                                    },
                                                                ),
                                                                redirects: [
                                                                    CshAstRedirect {
                                                                        descriptor: None,
                                                                        operator: ">&",
                                                                        target: "2",
                                                                    },
                                                                ],
                                                            },
                                                            Command(
                                                                CshAstCommand {
                                                                    assignments: [],
                                                                    name: "exit",
                                                                    args: [
                                                                        "1",
                                                                    ],
                                                                },
                                                            ),
                                                        ],
                                                    },
                                                },
                                            ],
                                            otherwise: None,
                                        },
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "finish_pending_reload",
                                                args: [],
                                            },
                                        ),
                                    ],
                                },
                            },
                            CshAstBranch {
                                condition: CshAst {
                                    commands: [
                                        Binary {
                                            left: Test(
                                                " -f $rule_file ",
                                            ),
                                            operator: And,
                                            right: Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "rule_runs_from_home",
                                                    args: [
                                                        "$rule_file",
                                                        "$binary",
                                                    ],
                                                },
                                            ),
                                        },
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "quarantine_rule",
                                                args: [
                                                    "$rule_file",
                                                ],
                                            },
                                        ),
                                    ],
                                },
                            },
                        ],
                        otherwise: None,
                    },
                    If {
                        branches: [
                            CshAstBranch {
                                condition: CshAst {
                                    commands: [
                                        Test(
                                            " -e $reload_needed_marker ",
                                        ),
                                    ],
                                },
                                body: CshAst {
                                    commands: [
                                        Command(
                                            CshAstCommand {
                                                assignments: [],
                                                name: "finish_pending_reload",
                                                args: [],
                                            },
                                        ),
                                    ],
                                },
                            },
                        ],
                        otherwise: None,
                    },
                ],
            },
        },
    ],
}
