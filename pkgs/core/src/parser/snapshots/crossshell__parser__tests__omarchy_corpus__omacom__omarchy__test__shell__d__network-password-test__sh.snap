---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/network-password-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "tmp",
                        value: "$(mktemp -d)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "trap",
                args: [
                    "rm -rf \"$tmp\"",
                    "EXIT",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "mkdir",
                args: [
                    "-p",
                    "$tmp/bin",
                ],
            },
        ),
        Redirected {
            expression: Command(
                CshAstCommand {
                    assignments: [],
                    name: "cat",
                    args: [],
                },
            ),
            redirects: [
                CshAstRedirect {
                    descriptor: None,
                    operator: ">",
                    target: "$tmp/bin/nmcli",
                },
                CshAstRedirect {
                    descriptor: None,
                    operator: "<<",
                    target: "EOF",
                    here_document: 0,
                },
            ],
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "chmod",
                args: [
                    "+x",
                    "$tmp/bin/nmcli",
                ],
            },
        ),
        Function {
            name: "run_failure_case",
            body: Group(
                CshAst {
                    commands: [
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "description=$1",
                                    "fields=$2",
                                    "expected_error=$3",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "local",
                                args: [
                                    "error",
                                ],
                            },
                        ),
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "export",
                                args: [
                                    "PW_NMCLI_FIELDS=$fields",
                                ],
                            },
                        ),
                        If {
                            branches: [
                                CshAstBranch {
                                    condition: CshAst {
                                        commands: [
                                            Redirected {
                                                expression: Command(
                                                    CshAstCommand {
                                                        assignments: [
                                                            CshAstAssignment {
                                                                name: "PATH",
                                                                value: "$tmp/bin:$PATH",
                                                            },
                                                        ],
                                                        name: "$ROOT/bin/omarchy-network-password",
                                                        args: [
                                                            "wlan0",
                                                        ],
                                                    },
                                                ),
                                                redirects: [
                                                    CshAstRedirect {
                                                        descriptor: None,
                                                        operator: ">",
                                                        target: "$tmp/output",
                                                    },
                                                    CshAstRedirect {
                                                        descriptor: Some(
                                                            "2",
                                                        ),
                                                        operator: ">",
                                                        target: "$tmp/error",
                                                    },
                                                ],
                                            },
                                        ],
                                    },
                                    body: CshAst {
                                        commands: [
                                            Command(
                                                CshAstCommand {
                                                    assignments: [],
                                                    name: "fail",
                                                    args: [
                                                        "$description",
                                                        "helper unexpectedly succeeded",
                                                    ],
                                                },
                                            ),
                                        ],
                                    },
                                },
                            ],
                            otherwise: None,
                        },
                        Command(
                            CshAstCommand {
                                assignments: [
                                    CshAstAssignment {
                                        name: "error",
                                        value: "$(<\"$tmp/error\")",
                                    },
                                ],
                                name: "",
                                args: [],
                            },
                        ),
                        Binary {
                            left: Test(
                                " $error == \"$expected_error\" ",
                            ),
                            operator: Or,
                            right: Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "fail",
                                    args: [
                                        "$description",
                                        "expected: $expected_error\\nactual: $error",
                                    ],
                                },
                            ),
                        },
                        Command(
                            CshAstCommand {
                                assignments: [],
                                name: "pass",
                                args: [
                                    "$description",
                                ],
                            },
                        ),
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "PW_NMCLI_FIELDS=$wpa-psk\\np,a:ss;word\\\\42\\n",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "output",
                        value: "$(PATH=\"$tmp/bin:$PATH\" \"$ROOT/bin/omarchy-network-password\" wlan0)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $output == 'p,a:ss;word\\42' ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "network password helper prints the raw password",
                        "expected: p,a:ss;word\\42\\nactual: $output",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "network password helper prints the raw password",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_failure_case",
                args: [
                    "network password helper refuses open networks",
                    "$none\\n\\n",
                    "This network has no password",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "export",
                args: [
                    "PW_NMCLI_FIELDS=$none\\n\\nwep-secret\\n",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "output",
                        value: "$(PATH=\"$tmp/bin:$PATH\" \"$ROOT/bin/omarchy-network-password\" wlan0)",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $output == \"wep-secret\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "network password helper prints WEP keys",
                        "expected: wep-secret\\nactual: $output",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "network password helper prints WEP keys",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "run_failure_case",
                args: [
                    "network password helper refuses enterprise networks",
                    "$wpa-eap\\nsecret\\n",
                    "Enterprise Wi-Fi has no shareable password",
                ],
            },
        ),
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            body: "#!/bin/bash\nif [[ $* == *GENERAL.CON-UUID* ]]; then\n  echo test-uuid\nelse\n  printf '%s' \"$PW_NMCLI_FIELDS\"\nfi\n",
        },
    ],
}
