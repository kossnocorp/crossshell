        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "assert_status",
                args: [
                    "$UNDETERMINED",
                    "[{\"name\":\"HDMI-A-1\",\"solitaryBlockedBy\":[\"WORKSPACE\"]}]",
                    "a monitor with no workspace yet cannot say",
                ],
