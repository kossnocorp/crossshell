                    "[{\"name\":\"LOCK-1\",\"description\":\"LOCK display\",\"activeWorkspace\":{\"name\":\"LOCK\"},\"solitaryBlockedBy\":[\"WINDOWED\"]}]",
                    "LOCK elsewhere in the monitor payload is not a locked session",
                ],
