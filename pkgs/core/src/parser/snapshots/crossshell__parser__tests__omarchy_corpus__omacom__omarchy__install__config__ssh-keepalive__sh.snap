---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/config/ssh-keepalive.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Test(
                                " ! -f /etc/ssh/ssh_config.d/20-omarchy-keepalive.conf ",
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "install",
                                    args: [
                                        "-d",
                                        "-m",
                                        "755",
                                        "/etc/ssh/ssh_config.d",
                                    ],
                                },
                            ),
                            Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "cat",
                                        args: [],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: ">",
                                        target: "/etc/ssh/ssh_config.d/20-omarchy-keepalive.conf",
                                    },
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: "<<",
                                        target: "EOF",
                                        here_document: 0,
                                    },
                                ],
                            },
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "chmod",
                                    args: [
                                        "644",
                                        "/etc/ssh/ssh_config.d/20-omarchy-keepalive.conf",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            body: "# Omarchy: notice dropped connections quickly instead of hanging until TCP\n# times out. Settings in ~/.ssh/config take precedence over these defaults.\nHost *\n  ServerAliveInterval 15\n  ServerAliveCountMax 3\n  ConnectTimeout 10\n",
        },
    ],
}
