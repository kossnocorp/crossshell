---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/test/shell.d/editor-env-test.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "set",
                args: [
                    "-euo",
                    "pipefail",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "source",
                args: [
                    "$(dirname \"$0\")/base-test.sh",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "envs",
                        value: "$ROOT/default/bash/envs",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "editor",
                        value: "$(env -u EDITOR bash -c 'source \"$1\"; printf \"%s\" \"$EDITOR\"' bash \"$envs\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $editor == \"omarchy-launch-editor --inline\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bash env provides a default editor",
                        "actual: $editor",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bash env provides a default editor",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "editor",
                        value: "$(EDITOR=helix bash -c 'source \"$1\"; printf \"%s\" \"$EDITOR\"' bash \"$envs\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $editor == \"helix\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "bash env preserves the inherited editor",
                        "actual: $editor",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "bash env preserves the inherited editor",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "sudo_editor",
                        value: "$(env -u EDITOR -u SUDO_EDITOR bash -c 'source \"$1\"; printf \"%s\" \"$SUDO_EDITOR\"' bash \"$envs\")",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Test(
                " $sudo_editor == \"omarchy-launch-editor --inline\" ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "fail",
                    args: [
                        "sudo uses the default editor",
                        "actual: $sudo_editor",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "pass",
                args: [
                    "sudo uses the default editor",
                ],
            },
        ),
    ],
}
