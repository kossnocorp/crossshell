---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/migrations/1786605598.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Rebuild the initramfs so NVIDIA-only systems shed nouveau's unused GSP firmware",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "hooks_conf",
                        value: "${OMARCHY_MKINITCPIO_HOOKS_CONF:-/etc/mkinitcpio.conf.d/omarchy_hooks.conf}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "nvidia_conf",
                        value: "${OMARCHY_MKINITCPIO_NVIDIA_CONF:-/etc/mkinitcpio.conf.d/nvidia.conf}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [
                    CshAstAssignment {
                        name: "rebuild_marker",
                        value: "${OMARCHY_KMS_REBUILD_MARKER:-/var/lib/omarchy/migrations/1786605598}",
                    },
                ],
                name: "",
                args: [],
            },
        ),
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [],
                    name: "omarchy-cmd-present",
                    args: [
                        "limine-mkinitcpio",
                    ],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " -f $hooks_conf && -f $nvidia_conf ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " ! -e $rebuild_marker ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Command(
                CshAstCommand {
                    assignments: [
                        CshAstAssignment {
                            name: "hooks",
                            value: "$(bash -c 'source \"$1\" && source \"$2\" && echo \" ${HOOKS[*]} \"' -- \"$nvidia_conf\" \"$hooks_conf\")",
                        },
                    ],
                    name: "",
                    args: [],
                },
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Binary {
            left: Test(
                " $hooks != *\" kms \"* ",
            ),
            operator: Or,
            right: Command(
                CshAstCommand {
                    assignments: [],
                    name: "exit",
                    args: [
                        "0",
                    ],
                },
            ),
        },
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "This machine no longer uses the kms hook; rebuilding the initramfs without nouveau",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sudo",
                args: [
                    "limine-mkinitcpio",
                ],
            },
        ),
        Command(
            CshAstCommand {
                assignments: [],
                name: "sudo",
                args: [
                    "install",
                    "-Dm644",
                    "/dev/null",
                    "$rebuild_marker",
                ],
            },
        ),
    ],
}
