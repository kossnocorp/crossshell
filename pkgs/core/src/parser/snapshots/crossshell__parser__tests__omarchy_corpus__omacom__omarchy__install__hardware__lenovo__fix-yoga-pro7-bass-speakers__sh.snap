---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/install/hardware/lenovo/fix-yoga-pro7-bass-speakers.sh"
expression: ast
---
CshAst {
    commands: [
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "omarchy-hw-match",
                                    args: [
                                        "Yoga Pro 7 14IAH10",
                                    ],
                                },
                            ),
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "mkdir",
                                        "-p",
                                        "/etc/modprobe.d",
                                    ],
                                },
                            ),
                            Redirected {
                                expression: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "sudo",
                                        args: [
                                            "tee",
                                            "/etc/modprobe.d/lenovo-yoga-pro7-bass.conf",
                                        ],
                                    },
                                ),
                                redirects: [
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: ">",
                                        target: "/dev/null",
                                    },
                                    CshAstRedirect {
                                        descriptor: None,
                                        operator: "<<",
                                        target: "EOF",
                                        here_document: 0,
                                    },
                                ],
                            },
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
    here_documents: [
        CshAstHereDocument {
            delimiter: "EOF",
            quoted: true,
            strip_tabs: false,
            body: "options snd-sof-intel-hda-generic hda_model=alc287-yoga9-bass-spk-pin\n",
        },
    ],
}
