---
source: pkgs/core/src/parser/mod.rs
description: "@omacom/omarchy/migrations/1788112314.sh"
expression: ast
---
CshAst {
    commands: [
        Command(
            CshAstCommand {
                assignments: [],
                name: "echo",
                args: [
                    "Point rc-channel installs at the rc package repository",
                ],
            },
        ),
        If {
            branches: [
                CshAstBranch {
                    condition: CshAst {
                        commands: [
                            Binary {
                                left: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-q",
                                            "https://rc-mirror.omarchy.org/",
                                            "/etc/pacman.d/mirrorlist",
                                        ],
                                    },
                                ),
                                operator: And,
                                right: Command(
                                    CshAstCommand {
                                        assignments: [],
                                        name: "grep",
                                        args: [
                                            "-q",
                                            "^Server = https://pkgs.omarchy.org/edge/",
                                            "/etc/pacman.conf",
                                        ],
                                    },
                                ),
                            },
                        ],
                    },
                    body: CshAst {
                        commands: [
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "sudo",
                                    args: [
                                        "sed",
                                        "-i",
                                        "s|^Server = https://pkgs.omarchy.org/edge/|Server = https://pkgs.omarchy.org/rc/|",
                                        "/etc/pacman.conf",
                                    ],
                                },
                            ),
                            Command(
                                CshAstCommand {
                                    assignments: [],
                                    name: "echo",
                                    args: [
                                        "Switched the [omarchy] repository to the rc channel to match this machine's rc mirror.",
                                    ],
                                },
                            ),
                        ],
                    },
                },
            ],
            otherwise: None,
        },
    ],
}
