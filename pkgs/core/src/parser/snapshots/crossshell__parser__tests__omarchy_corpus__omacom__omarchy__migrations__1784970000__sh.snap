                    CshAstAssignment {
                        name: "effective_us",
                        value: "$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \\\n  org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null | awk '{print $2}' || true)",
