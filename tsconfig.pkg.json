{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [
    "${configDir}/*",
    "${configDir}/src/**/*",
    "${configDir}/vendor/**/*",
    "${configDir}/examples/**/*",
    "${configDir}/test/**/*"
  ],
  "compilerOptions": {
    // Resolve
    "rootDir": "${configDir}",
    "paths": {},
    // Output
    "target": "esnext",
    "outDir": "${configDir}/.ts",
    "tsBuildInfoFile": "${configDir}/.ts/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    // Modules
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "moduleDetection": "force", // Stop treating files without imports/exports as single global scripts
    "allowImportingTsExtensions": true, // Use .ts extensions to make imports work in Node.js
    "verbatimModuleSyntax": true, // Enforce type-only imports
    "resolveJsonModule": true,
    "allowJs": true, // Allow importing JavaScript files
    // Env
    "lib": ["ESNext"],
    "erasableSyntaxOnly": true,
    // Checks
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true, // Force using override modifier in classes
    "checkJs": true, // Allow using JSDoc to type check JavaScript files
    // Build
    "incremental": true,
    // Project references
    "composite": true
  }
}
